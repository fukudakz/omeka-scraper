    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マリンキッド・のこぎり鮫の襲撃" ;
    schema:about "海底パトロール隊司令官を父にもつマリン少年の冒険物語。ファームとエルムの親子が海底農場を開拓する。それを荒す怪ロボット。マリン少年が親子と力を合せてロボットを操る海賊をやっつけ、海底の平和を守る。テレビ動画社がフジTVのカラー放送用のテスト版として製作したものの劇場用再編集版。カラー実験放映は四十年四月四日から三回放映。" ;
    schema:color "カラー" ;
    schema:contentType "16mm" ;
    schema:contributor "撮影：辻友一", "演出：小山内治夫", "脚本：松本守正", "製作：足立実" ;
    schema:dateCreated "1966年11月" ;
    schema:identifier "NAE0784" ;
    schema:name "マリンキッド・のこぎり鮫の襲撃" ;
    schema:pagination "286" ;
    schema:productionCompany "テレビ動画社" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0784> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1467>
