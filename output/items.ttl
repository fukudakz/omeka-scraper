    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "アンデルセン物語" ;
    schema:about "アーサー・ランキンJr.がプロデュース、 持永只仁のMOMプロが人形操作した日米合作の人形映画。内容は実写で、舞台は北欧。貧しい靴屋の少年アンデルセンが野原や、小川のボートで眠り、夢を見る。その夢が「親指姫」「裸の王様」 「人魚姫」の三つの人形映画になるというもの。" ;
    schema:color "カラー" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーション：持永只仁 ほか" ;
    schema:disambiguatingDescription "実写併用" ;
    schema:duration "1時間30分" ;
    schema:identifier "NAE0785" ;
    schema:name "アンデルセン物語" ;
    schema:pagination "286" ;
    schema:productionCompany "MOMプロ、ビデオ・クラフト（米）" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0785> .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1468>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
