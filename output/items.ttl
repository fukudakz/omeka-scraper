    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "バグダッド姫" ;
    schema:about "アラビアンナイト物語の動画で、八巻という長編だが、あまり話題にならなかった。手塚治虫がアニメーターになりたくて三幸スタジオを訪ねた時、芦田巌はちょうどこの映画を製作していた。あまり良い出来の作品とは言い難いが、動きはフルアニメーションであり、今日のテレビ用アニメとは比べ物にならない程の力作である。日本最初の長編漫画映画としてもう少し高く評価したい。" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16662>, <https://www.nihon-animation-eigashi.com/work-db/item/18755>, <https://www.nihon-animation-eigashi.com/work-db/item/23386>, <https://www.nihon-animation-eigashi.com/work-db/item/50080> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作曲：服部良一", "作画：福田里三郎", "作詩：サトウ・ハチロー", "原案・演出：芦田巌", "撮影：川西昭治" ;
    schema:identifier "NAE0462" ;
    schema:name "バグダッド姫" ;
    schema:pagination "237" ;
    schema:productionCompany "三幸映画社" ;
    schema:releaseDate "1948年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0462> ;
    schema:volumeNumber "8" .

