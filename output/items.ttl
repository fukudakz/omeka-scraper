    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "道徳的なしわ （WRINKLED MORALS）" ;
    schema:about "人形映画畑の飯沢匡の演出だけに布に動きを与えた物体アニメーションを作った。布に皺を作るために、真空装置や圧縮空気を使用したが失敗。結局、水を使用してアニメートした。七つの大罪のうち怒り、強欲、怠惰、尊大、邪悪の五つのテーマを布の皺で表現させる。サウンド効果も面白く異色な作品。第二回「アニメーション・フェスティバル」で公開。" ;
    schema:color "カラー" ;
    schema:contentType "35mm" ;
    schema:contributor "アニメーショ ン：粕谷守", "撮影：隅田雄二郎、鍵山幸弘", "美術助手：津田勝利", "脚本・演出：飯沢匡", "音響：吉田美能留" ;
    schema:duration "5分" ;
    schema:identifier "NAE0724" ;
    schema:name "道徳的なしわ （WRINKLED MORALS）" ;
    schema:pagination "276" ;
    schema:productionCompany "シバ・プロダクション" ;
    schema:releaseDate "1965年10月" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0724> ;
    schema:volumeNumber "1" .

