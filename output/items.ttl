<https://www.nihon-animation-eigashi.com/work-db/api/items/732>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "日の丸旗之助・山賊退治" ;
    schema:about "\"わかもと\"のPR動画。ポパイを参考にしたのか山賊のキャラクターはプルートそっくり。ポパイはホウレン草だが、旗之助は、\"わかもと\"を飲んで力をつける。製作年度が確定しないので推定で挿入。後にコロナ映画社から「三太郎 旅日記」と改題し、わかもとのPR部分をカットして再版されている。" ;
    schema:alternateName "三太と山賊" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "瀬尾光世" ;
    schema:description "武者修業の旅に出た旗之助は、家宝の刀を盗まれた少年武士を助け山賊退治に出かける。 途中で腹鼓の鳴らなくなった狸と乳の出なくなった母猿に薬を与えて助ける。狸は商人に化けて山賊をおびき出し、旗之助と少年は動物達の力を借りて山賊を退治し、刀を取り返す。" ;
    schema:identifier "NAE0346" ;
    schema:name "日の丸旗之助・山賊退治" ;
    schema:pagination "222" ;
    schema:productionCompany "芸術映画社" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0346> ;
    schema:volumeNumber "1" .

