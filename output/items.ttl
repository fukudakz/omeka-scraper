    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ある男の場合 No.3" ;
    schema:about "“ある男”シリーズの第三作。セルを使用せず動画用紙に直接イラストを描き撮影したもの。" ;
    schema:awards "フィルム・アート・フェスティバル入選" ;
    schema:color "カラー" ;
    schema:contentType "16mm" ;
    schema:contributor "製作・脚本・動画・演出：月岡貞夫 「現代恐怖夜話集」より" ;
    schema:description "檻の中の調教師とライオン。両者のバランスをとるのは一本の鞭のみ。うなる鞭から逃げたいライオン。うっかり手を滑らせた調教師の鞭をライオンが取って立場逆転。うなる鞭から逃げたい男。ついに火の輪くぐりまでやるハメになる。檻から脱出したが、その外にまた檻が...。現代社会を諷刺した作品である。" ;
    schema:duration "5分" ;
    schema:identifier "NAE0815" ;
    schema:name "ある男の場合 No.3" ;
    schema:pagination "292" ;
    schema:productionCompany "月岡貞夫" ;
    schema:releaseDate "1968年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0815> ;
    schema:volumeNumber "1" .

