    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "じゃんけんぽん" ;
    schema:about "母蝶が機智をもってカニから子供の生命を守る話を音楽のリズムで描いた影絵。荒井和五郎の影絵の最後の作品。以後、荒井は影絵から人形映画製作に転身。三十三年、人形映画「黄色い森の物語」を発表。現在「鶴の恩返し」に題材を得て、「昔噺・名残りの大布」を製作中とのことである。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽：安倍盛" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：荒井和五郎" ;
    schema:description "カマキリからサナギを奪ったカニはエビガニと争ってジャンケンポンをするが、両方ともハサミなので勝負がつかない。そのうち、サナギは蝶になり飛んで行ってしまう。" ;
    schema:distribution "配給：土田商会" ;
    schema:duration "9分" ;
    schema:identifier "NAE0472" ;
    schema:materialExtent "239m" ;
    schema:name "じゃんけんぽん" ;
    schema:pagination "238" ;
    schema:productionCompany "日本漫画映画社" ;
    schema:releaseDate "1948年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0472> ;
    schema:volumeNumber "1" .

