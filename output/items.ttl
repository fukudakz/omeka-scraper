    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "黒いきこりと白いきこり" ;
    schema:audio "トーキー" ;
    schema:author "浜田広介" ;
    schema:color "フジカラー" ;
    schema:composer "音楽：斎藤高順" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：熊川正雄、大工原章、市野正二、長沼寿美子、進藤進、内山孝、寺千賀雄", "原画：森康二、熊川正雄", "撮影：石川光明、佐倉紀行", "演出：薮下泰司", "脚色：森康二", "製作：山本早苗" ;
    schema:dateCreated "1956年7月" ;
    schema:description "雪の山里の昔話。心の黒いきこりは雪で食物がなく、食を求めてやって来た熊、狐、リスを撃ち殺す。三匹の魂は雪山をさまようが、哀れに思った神様は元の姿に戻してくれる。三匹は心の温いきこりの小屋を訪ねると、きこりは親切に迎えてくれる。山は猛吹雪となり、雪女が心の黒いきこりの家を襲い、きこりをはじめ、たき火まで凍らせてしまう。心の温いきこりの小屋を襲うが、暖い小屋には歯が立たず雪女は退散してしまう。'56年教育映画祭入賞。" ;
    schema:duration "15分" ;
    schema:identifier "NAE0559" ;
    schema:materialExtent "409m" ;
    schema:name "黒いきこりと白いきこり" ;
    schema:pagination "250" ;
    schema:productionCompany "日動映画" ;
    schema:releaseDate "1956年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0559> ;
    schema:volumeNumber "2" .

