<https://www.nihon-animation-eigashi.com/work-db/api/items/1322>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "パンドラの箱" ;
    schema:actors "語り手：宇野重吉" ;
    schema:audio "トーキー" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：宅孝二、日暮雅信" ;
    schema:contentType "35mm" ;
    schema:contributor "演出：上田圭子", "脚本・作画・撮影：森川信英、渡辺千津子", "製作：小倉直雄" ;
    schema:dateCreated "1961年11月10日" ;
    schema:description "宇宙に地球という一つの天体が誕生。天地創造につぎ神様は男の子を創った。一人では淋しかろうと女の子を創り、二人は仲よしになる。楽園に悪魔がやって来て二人に一つの箱をプレゼント。箱の中身はパンドラの箱といい誘惑、欲望、争いの種がいっぱい入っている。誘惑に負けた女の子はついに箱をあける。中からあらゆる不幸が出て来て地上は暗黒の世界となり、悪魔は我もの顔で仲間を増やす。だが、男の子は悪魔に敢然と立ち向うが多勢に無勢。しかしパンドラの箱には悪と共に希望も入っていた。この希望を取り出した時、勇気がよみがえり、悪は追出される。ギリシャ神話のはり絵手法による動画化。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0640" ;
    schema:materialExtent "275m" ;
    schema:name "パンドラの箱" ;
    schema:pagination "262" ;
    schema:productionCompany "都映画" ;
    schema:releaseDate "1961年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0640> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1323>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "釈迦の生涯" ;
    schema:about "故大藤信郎が生前に製作した影絵映画 「大聖釈尊」前後編を大藤没後、改めて合作しワイド版に編集し直したもの。" ;
    schema:actors "解説：高橋博" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽：本田鉄麿" ;
    schema:contentType "35mm" ;
    schema:contributor "構成・作画・演出：大藤信郎", "製作：原島淑郎" ;
    schema:dateCreated "1961年11月" ;
    schema:description "二千五百年も昔のこと、インドの花園に眠るマヤ夫人は白象の夢を見る。やがて玉の様な王子が生まれる。十二才になった王子はさまざまな世の無常にうたれて苦悩の日々が始まる。父王は美しい姫を迎え、王子の妃とするが、王子の悩みは依然と続き、ついに王城をあとに苦しい修道者となり放浪の旅に出る。しかし「身体を苦しめれば心も乱れる。乱れた心で悟りが得られるだろうか」と自問自答。一人、菩提樹の下に座して悟りの行に入る。あらゆる悪魔達の誘惑にうちかち、大悟して釈迦無尼仏となるが、長い伝道の果て、娑羅双樹の下に横たわり、入滅の日まで迷える人々を導く釈迦の一代記。" ;
    schema:disambiguatingDescription "ワイド版" ;
    schema:duration "1時間12分" ;
    schema:identifier "NAE0641" ;
    schema:materialExtent "1973m" ;
    schema:name "釈迦の生涯" ;
    schema:pagination "262" ;
    schema:productionCompany "三幸スタジオ" ;
    schema:releaseDate "1961年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0641> ;
    schema:volumeNumber "10" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1324>
