<https://www.nihon-animation-eigashi.com/work-db/api/items/74>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-01-26T02:31:28+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:04+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "姥捨山" ;
    schema:about "おとぎ話「うばすて山」を動画化した敬老精神高揚映画。" ;
    schema:audio "サイレント" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "山本早苗" ;
    schema:description "老人を捨てるおきてのある国で、一人の若者が老母を捨てかねて地下にかくして置く。隣国より殿様に難題がかけられた時、老母の智恵を借りて難なく解決。以後老人を大切にする国となる。" ;
    schema:identifier "NAE0051" ;
    schema:name "姥捨山" ;
    schema:pagination "194" ;
    schema:productionCompany "山本漫画製作所" ;
    schema:releaseDate "1925年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0051> ;
    schema:volumeNumber "3" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/740>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "カチカチ山" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽出演：劇団ドウゲキ", "音楽：高橋虎之助" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：柾木統三", "彩画：木村実", "脚色：政岡憲三" ;
    schema:description "ある農家でおじいさん、おばあさんが兎を飼って可愛がっていた。ある日悪い狸が畑を荒したので、おじいさん怒ってワナを仕掛け捕えた。悪狸はおじいさんの留守におばあさんをだまし縄をといてもらうが、逆におばあさんをくくり狸の家へ連れて行く。それを見た兎はおばあさんを助けようと、ごちそうを用意し狸の家へ。ごちそうにつられた狸は兎のかついでいる柴を運ぶ約束をする。狸は柴をかつぎ、兎はすきを見て火打石で火をつける。狸は大やけど。次の日、兎は薬だと だまして唐がらしを狸の背中にぬる。苦しんでいる間におばあさんを救出しようとするが失敗。今度は狸を魚釣に誘う。狸の舟は泥舟で海の真中でとけて溺れる。兎は狸を助けてやり、狸は改心する。助かったおばあさんとおじいさん、それに兎と狸が餅つきの手伝いをする。畑を荒す悪狸が畑でおじいさんに向かってオナラをぶっ放す描写があり、非常に下品な印象を強く与える漫画映画であった。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0354" ;
    schema:materialExtent "279m" ;
    schema:name "カチカチ山" ;
    schema:pagination "222" ;
    schema:productionCompany "日本動画研究所" ;
    schema:releaseDate "1939年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0354> ;
    schema:volumeNumber "1" .

