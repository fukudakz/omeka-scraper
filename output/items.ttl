    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "体育デー" ;
    schema:alternateName "漫画体育デー" ;
    schema:audio "サイレント" ;
    schema:author "青地忠三" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/23534>, <https://www.nihon-animation-eigashi.com/work-db/item/32485-17> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司", "脚色：青地忠三" ;
    schema:description "動物園の休日、動物たちが体育大会を開く。猿の器械体操、ライオンと虎の剣道と柔道、白熊と河馬の水泳と高跳込み、全員の合同体操、カンガルーと豚の拳斗、そして最後に象対全員の綱引で終わる。" ;
    schema:identifier "NAE0208" ;
    schema:name "体育デー" ;
    schema:pagination "206" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1932年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0208> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/595>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T04:33:38+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "あひるの子" ;
    schema:about "【R6追加】\n横浜シネマ商会の短篇文化映画シリーズ「アテナライブラリー Atena Library」第62篇。35mm版の発売は関東方面を岡本洋行が、関西方面を奥商会が行い、16mm版は小西六本店が行った。", "【原文】\nアンデルセン童話の動画化で外国の話だが、語りもキャラクターも完全に日本調になっている。後にトーキー版が製作されたが、トーキーでは前後にアンデルセンの本を読む少女の実写が加えられ、中間のタイトル文字が抜かれている。" ;
    schema:author "青地忠三" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/20066>, <https://www.nihon-animation-eigashi.com/work-db/item/32439> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司", "脚色：青地忠三" ;
    schema:correction "解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "アヒルの卵の中に混って生まれた白鳥の子が、いろいろ迫害を受ける。ある別荘にいる猫と鶏の友情に助けられ成長するが、秋になると自分を生んでくれた親のことを想像する。" ;
    schema:disambiguatingDescription "音楽伴奏版" ;
    schema:distribution "提供：横浜シネマ商会", "配給 [関東]：岡本洋行", "配給 [関西]：奥商会" ;
    schema:duration "19分" ;
    schema:identifier "NAE0209" ;
    schema:materialExtent "526m" ;
    schema:name "あひるの子" ;
    schema:pagination "206" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1932年9月（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0209> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/596>
    rdf:type o:Item, schema:CreativeWork ;
