    schema:productionCompany "東映動画" ;
    schema:releaseDate "1961年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0650> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1333>
    rdf:type o:Item, schema:CreativeWork ;
