    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "Toy Chest from Japan" ;
    schema:about "日本で生産される各種のオモチャを海外に紹介するPR映画。齣撮りの人形映画のテクニックが使用されたと推定される。" ;
    schema:audio "トーキー" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：渋谷修" ;
    schema:contentType "35mm" ;
    schema:contributor "撮影：小松浩", "演出：藤原杉雄", "美術：山崎正夫", "脚本：岡崎薫子", "製作：三井高孟" ;
    schema:dateCreated "1955年2月" ;
    schema:description "おとぎ話の様な森の家からオモチャたちが出て来て動き回る。水上ではオモチャのボート・レース。泳ぐ小鳥たち。砂山のトンネルからオモチャ列車が出発。模型の山を越え、川を渡りオモチャの町に到着。町ではオモチャのサーカス団が熱演。象、熊、ライオンが登場し曲芸をする。最後にクリスマスで雪の中をサンタの人形がジングルベルのメロディにのってソリで走る。" ;
    schema:duration "19分" ;
    schema:identifier "NAE0543" ;
    schema:materialExtent "509m" ;
    schema:name "Toy Chest from Japan" ;
    schema:pagination "246" ;
    schema:productionCompany "三井芸術プロダクション" ;
    schema:releaseDate "1955年" ;
    schema:sourceOrganization "通産省" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0543> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1226>
    rdf:type o:Item, schema:CreativeWork ;
