    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かうもり" ;
    schema:about "【R6追加】\n横浜シネマ商会の短篇文化映画シリーズ「アテナライブラリー Atena Library」第47篇。35mm版の発売は関東方面を岡本洋行が、関西方面を奥商会が行い、16mm版は小西六本店が行った。" ;
    schema:alternateName "かふもり" ;
    schema:audio "サイレント" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/32485-6> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司" ;
    schema:correction "配給、フォーマット、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "昔、鳥と獣が戦争した。激しい戦だったが、利口なコウモリは双方ともに旗色の良い時だけ味方した。やがて戦争は和睦になったが、コウモリだけは仲間はずれになり、以来夜の世界をとび回らなければならなくなった。教訓漫画。" ;
    schema:distribution "提供：横浜シネマ商会", "配給 [関東]：岡本洋行", "配給 [関西]：奥商会" ;
    schema:duration "6分" ;
    schema:identifier "NAE0159" ;
    schema:materialExtent "114m" ;
    schema:name "かうもり" ;
    schema:pagination "202" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1931年1月（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0159> ;
    schema:volumeNumber "1" .

