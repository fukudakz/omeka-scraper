<https://www.nihon-animation-eigashi.com/work-db/api/items/1544>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:51+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "長靴をはいた猫" ;
    schema:about "フランスの童話作家シャルル・ペロー（一六二八〜一七〇三）の原作の動画化。ギャグに徹したアクション・ドラマとして成功した。ギャグ監修として中原弓彦を招き、ギャグ会議が開かれたことも話題になった。作画監督の森康二は実際に六十匹もの猫をあらゆる角度からスケッチして動作の研究をしたそうだ。また猫の生態を撮影しライヴ・アクションの参考にされたそうだ。姫を魔王にさらわれ、救出に魔王の住む怪奇な城に出かける後半が圧巻。" ;
    schema:actors "[ペロ] 石川進、[ピエール] 藤田淑子、[ローザ姫] 榊原ルミ、[殺し屋] 水森亜土、[鼡のチビ] 水垣洋子、[鼡の首領] 熊倉一雄、[ダニエル] 内海賢二、[レーモン] 八代駿、[殺し屋の首領] 愛川欽也、[魔王] 小池朝雄、[王様] 益田喜頓" ;
    schema:audio "トーキー" ;
    schema:author "シャルル・ペロー" ;
    schema:awards "モスクワ国際映画祭児童映画部門“もっともおもしろい映画賞”", "七月七日モスクワ国際映画祭美術家同盟賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/10883>, <https://www.nihon-animation-eigashi.com/work-db/item/11935>, <https://www.nihon-animation-eigashi.com/work-db/item/12132>, <https://www.nihon-animation-eigashi.com/work-db/item/12809>, <https://www.nihon-animation-eigashi.com/work-db/item/13331>, <https://www.nihon-animation-eigashi.com/work-db/item/14833> ;
    schema:color "カラー" ;
    schema:composer "作曲：宇野誠一郎", "作詞：井上ひさし、山元護久", "歌：石川進、水垣洋子、ボーカルショップ、トリオ・ボワン", "音楽：宇野誠一郎" ;
    schema:contentType "35mm" ;
    schema:contributor "ギャグ監修：中原弓彦", "ゼログラフィ：松本寿夫", "トレース：保田道世、武田澄子", "作画監督：森康二", "動画：堰合昇、吉田茂承、斎藤智、坂野隆雄、小林敏明、小川明弘、藤本芳弘、松原明徳、飯田銈一、坂野勝子、田村真也、黒沢隆夫、浅田清隆、篠原征子、阿久津文雄、正井融、池原昭治、堀池義治、服部照夫、角田紘一、草間真之介、長沼寿美子、山田みよ", "原画：大塚康生、奥山玲子、菊池貞雄、小田部羊一、大田朱実、 宮崎駿、大工原章", "彩色： 宮本慶子、平田正子", "撮影：平尾三喜、高梨洋一", "検査：新納三郎、森川桂士", "演出助手：及部保雄、蕪木登喜司", "演出：矢吹公郎", "特殊効果：平尾千秋", "編集：千蔵豊", "美術：浦田又治、土田勇", "背景：内川文広、伊藤英治、牧野光成、城戸求", "脚本：井上ひさし、山元護久", "製作進行：古沢義治", "製作：大川博", "記録：河島利子", "調色：谷口洋平", "録音：神原広巳", "音響効果：大平紀義" ;
    schema:dateCreated "1969年2月" ;
    schema:disambiguatingDescription "東映スコープ" ;
    schema:duration "1時間20分" ;
    schema:identifier "NAE0862" ;
    schema:materialExtent "2195m" ;
    schema:name "長靴をはいた猫" ;
    schema:pagination "298" ;
    schema:producer "関政次郎、有賀健、渋谷幹雄" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1969年3月18日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0862> ;
    schema:volumeNumber "8" ;
    schema:workPresented "東映系" .

