<https://www.nihon-animation-eigashi.com/work-db/api/items/737>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "べんけい対ウシワカ" ;
    schema:about "政岡憲三は松竹の協力で京都三条に小さいスタジオを設け、第一回作品として製作したも ので、音楽は一部にプレ・スコアリングを採用した。牛若の声は政岡夫人、弁慶の声は政岡憲三自身の吹き込み。" ;
    schema:alternateName "弁慶対牛若" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16594>, <https://www.nihon-animation-eigashi.com/work-db/item/19844> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "仕上：木村角山", "動画：熊川正雄、桑田良太郎", "原画・監督：政岡憲三", "録音：日本映画科学研究所" ;
    schema:description "鞍馬山で牛若丸が武術の稽古をしている所へ天狗が現われ、森の木を傷つけたことをとがめる。牛若丸は武術修業の目的を説明した。天狗は牛若丸に猛稽古をつけてくれる。修練のかいあって、天狗は牛若丸に極意の一巻を授ける。京へ 出た牛若丸はある夜五条の橋の上で、刀千本を集めようと志し、すでに九百九十九本まであつめた弁慶と出会う。弁慶は牛若丸に散々な目にあい降参し弟子になる。牛若は主従のしるしにと小刀を一本与えたので、弁慶の願はかなう。" ;
    schema:distribution "日本短篇映画社" ;
    schema:duration "14分" ;
    schema:identifier "NAE0351" ;
    schema:materialExtent "396m" ;
    schema:name "べんけい対ウシワカ" ;
    schema:pagination "222" ;
    schema:productionCompany "日本動画研究所" ;
    schema:releaseDate "1939年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0351> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/738>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ニャンの浦島" ;
    schema:about "日本最初のオール・プレスコによる作品。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "日立二郎" ;
    schema:contentType "35mm" ;
    schema:contributor "撮影：木村角山", "監督：政岡憲三", "録音：日本映画科学研究所" ;
    schema:description "黒猫の黒ニャンは色が黒いので皆から嫌われる。悲しみのあまり海へ飛込むが、波に打ち上げられる。同じく波に打ち上げられひっくりかえって起き上れない亀を助けてやる。亀はお礼に竜宮城へ案内するが、窓から見えるイワシの群を見て急にお腹がすき、窓ガラスを破ったので、竜宮は水びたし。防水隊の出動で水は治まるが、タコ大臣から叱られ陸へ連れ戻される。帰ってみると我家は留守。お土産にもらった玉手箱を開けると白煙が出て白毛の猫となり、皆から可愛がられるようになる。" ;
    schema:distribution "日本短篇映画社" ;
    schema:identifier "NAE0352" ;
    schema:name "ニャンの浦島" ;
    schema:pagination "222" ;
    schema:productionCompany "日本動画研究所" ;
    schema:releaseDate "1939年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0352> ;
    schema:volumeNumber "1" .

