    o:title "小鬼の橋" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "撮影：水戸芳人", "演出：鎌倉伴作", "製作：桑名理夫" ;
    schema:dateCreated "1958年11月" ;
    schema:description "ある村にいたずら小鬼が住みつき、二人の子供と仲良しになる。村人に小鬼が捕まるが二人は逃がしてやる。村の橋が大雨で流されたが小鬼はお礼返しに一夜でかけ直す。日本昔話の動画化。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0596" ;
    schema:materialExtent "265m" ;
    schema:name "小鬼の橋" ;
    schema:pagination "254" ;
