    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "笛吹き王子（チビッコ笛吹き）" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "16mm" ;
    schema:contributor "演出：高橋克雄、松本治助", "製作：石川孝寿" ;
    schema:dateCreated "1959年2月" ;
    schema:description "チビッ子笛吹きは熊と狐、兎をお供に動物バレーを巡業していた。ある町でチビッ子は山男からお姫様を助け出す。悪い隊長に殺されかかるが、お供の動物達や仲良しになった山男がチビッ子を助け、チビッ子はお姫様と結婚する。原作はグリム童話。" ;
    schema:duration "27分" ;
    schema:identifier "NAE0613" ;
    schema:materialExtent "297m" ;
    schema:name "笛吹き王子（チビッコ笛吹き）" ;
    schema:pagination "257" ;
    schema:productionCompany "東京中央人形劇場" ;
    schema:releaseDate "1959年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0613> ;
    schema:volumeNumber "3" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1296>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ひょうたんすずめ" ;
    schema:about "おとぎプロ第二作。日本民話「不思議なひょうたん」に題材を得て、二十三人のスタッフが十五ヶ月かかって製作した。ラスト近くでトゲだらけの不気味なひょうたんから真っ黒のスミのお化けが続出してのオンパレードは圧巻。このシークェンス担当は才人鈴木伸一。鈴木伸一は奇しくも五十一年に自主作品「ひょうたん」を製作している。配給の東宝側の公開方法が不親切で、大阪では佐藤允の刑事もの「手錠をかけろ」と二本立封切。もう少し子供向きの作品と併映出来なかったものか。" ;
    schema:audio "トーキー" ;
    schema:color "資生堂おとぎカラー （イーストマン・カラー）" ;
    schema:composer "音楽：宅孝二" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：鈴木伸一、町山みつひろ、秦泉寺博、山本栄一、山田幸弘、永田敏郎、伊藤征史", "原画・監督：横山隆一", "彩色：長井克子、田口恵美子、木村協子、内山絢子、友野長子、市原妙子、小山照子、関根スミ子", "撮影・編集：小松義孝、岡田英美子、大久保宏", "背景：中原健喜" ;
    schema:description "平和なカエル村にある日、コルトならぬパチンコの早射ちガンマンで暴れ者のダンベエと息子のケロ八がやって来た。ひょうたんの家に住む可愛いい雀はダンベエに捕まり、見世物にされたあげく死んだ。親切なゼンスケ、ピョン子親子がお墓を作ると、ひょうたんの芽が出て大きな実がなった。その実を取るとお米がざくざく出て親子は金持になった。ダンベエはある夜、ひょうたんを盗み出すが、もうお米は出て来ない。怒って別の雀を殺して埋めるとトゲのある気味悪いひょうたんが出来た。そこから黒いスミのお化けがゾロゾロ出て来たので、ダンベエ親子は村から逃げ出した。" ;
    schema:duration "55分" ;
    schema:identifier "NAE0614" ;
    schema:materialExtent "1506m" ;
    schema:name "ひょうたんすずめ" ;
    schema:pagination "257" ;
    schema:productionCompany "おとぎプロダクション" ;
    schema:releaseDate "1959年2月10日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0614> ;
    schema:volumeNumber "4" ;
    schema:workPresented "東宝系" .

