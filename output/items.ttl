    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "スパイ撃滅" ;
    schema:about "スパイの三人の男女（男二人、女一人）には角があり、鬼（米鬼、英鬼）を表現している。 映画の最後に「真の日本人たれ、国を思う一億の団結、それが防諜だ!」の標語が画面いっぱいに入る。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16200>, <https://www.nihon-animation-eigashi.com/work-db/item/20032>, <https://www.nihon-animation-eigashi.com/work-db/item/20359-2>, <https://www.nihon-animation-eigashi.com/work-db/item/21215> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・撮影：山本早苗", "指導：防諜協会" ;
    schema:description "米、英洋上会談でルーズベルト、チャーチルは何の密談をしたのか、間もなくアメリカの飛行場から三人の男女が日本に向け出発した。太平洋を渡り落下傘で降下した三人組を相手に、大和一家は国土防衛の念にかられ、鶏や犬までもが協力、三人組の行く先々での謀略活動を粉砕した。" ;
    schema:duration "12分" ;
    schema:identifier "NAE0400" ;
    schema:materialExtent "333m" ;
    schema:name "スパイ撃滅" ;
    schema:pagination "228" ;
    schema:productionCompany "三幸商会" ;
    schema:releaseDate "1942年7月16日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0400> ;
    schema:volumeNumber "1" ;
    schema:workPresented "横浜 朝日ニュース劇場" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/786>
    rdf:type o:Item, schema:CreativeWork ;
