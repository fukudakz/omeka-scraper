    o:title "三公と蛸" ;
    schema:audio "アフレコ・トーキー（アフレコ）" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/50197> ;
    schema:color "白黒" ;
    schema:composer "コロムビア文芸部" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司" ;
    schema:description "怠け者の魚屋の三公は今朝も仕入れに行かずごろ寝をしている。そこへ廃兵の友人が宝を乗せて沈んだという船の場所を書いた地図を持って来て、上手く引上げたら山分けしようと持ちかける。三公は一人小舟で宝探しに行き、上手く箱を引上げるが、大蛸においかけられる。箱の中には蛸の妻と子供達が入っていたのだ。" ;
    schema:duration "20分" ;
    schema:identifier "NAE0227" ;
    schema:materialExtent "556m" ;
    schema:name "三公と蛸" ;
    schema:pagination "209" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1933年" ;
    schema:sourceOrganization "逓信省簡易保険局" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0227> ;
    schema:volumeNumber "2" .

