    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "四十人の盗賊" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：上野武夫", "撮影：米原広", "操者：東浦潔", "脚色：東浦康介", "製作：鈴木俊夫" ;
    schema:correction "作者・スタッフを更新、別バージョンを関連付け [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "日本最初の影絵映画といわれている。貧乏なアリババが盗賊の岩屋を見つけ金貨を持ち帰る。兄のカシムがそれを見つけ、岩屋へ出かけるが、宝物に目がくらみ呪文を忘れ盗賊に刺される。 アリババも狙われるが、その度に女中に助けられ、 逆に盗賊を滅す。" ;
    schema:distribution "スターフィルム社" ;
    schema:identifier "NAE0116" ;
    schema:isRelatedTo <https://www.nihon-animation-eigashi.com/work-db/api/items/524> ;
    schema:name "四十人の盗賊" ;
    schema:pagination "198" ;
    schema:productionCompany "銀映社" ;
    schema:releaseDate "1928年9月14日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0116> ;
    schema:volumeNumber "3" ;
    schema:workPresented "東京館", "邦楽座", "電気館" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/503>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:06+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "出世忍術・松之助再来" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "原案・脚色・操作・絵画・字幕：中山呑海", "撮影：出口昌友" ;
    schema:description "ある城下に怠け者の獅子飛松之助という浪人がいた。空腹続きの毎日だったが、働く気もない。窓の外の木立で烏までアホウとからかう。 気短かの松之助は刀を握って外に飛び出すが、烏と思ったのは烏天狗で、追いかけている内に古井戸へはまり、古井戸は地獄まで続いている。地獄では閻魔大王に怠け心をしかられ、改心し武士道にはげむ。再び世に出た松之助は仙人の教えで忍術を覚え、妖怪退治をしたり、孝子の助太刀をしたりして武名を高める。" ;
    schema:identifier "NAE0117" ;
    schema:name "出世忍術・松之助再来" ;
    schema:pagination "198" ;
    schema:productionCompany "日活" ;
    schema:releaseDate "1928年8月10日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0117> ;
    schema:volumeNumber "3" ;
    schema:workPresented "みやこ座", "富士館" .

