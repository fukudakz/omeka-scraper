    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "子うさぎものがたり" ;
    schema:about "ディズニーの「バンビ」の影響が濃いが、見事なフル・アニメで、モノクロが惜しい佳作。" ;
    schema:actors "解説：加藤幸子" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15516> ;
    schema:color "白黒" ;
    schema:composer "歌：三枝喜美子", "音楽：坂本良隆" ;
    schema:contentType "35mm" ;
    schema:contributor "作画協力：古沢日出夫", "効果：EFグループ", "動画：長沼寿美子、若松一、岡田弥生", "撮影：高城泰策、石川光明", "演出・原画：森康二", "背景：中島清", "脚本：薮下泰司", "製作：山本早苗", "録音：槙田金弥" ;
    schema:dateCreated "1954年3月" ;
    schema:description "ある森に母兎と二匹の子兎が住んでいる。母兎は子兎に生き方を教える。兄兎はよく教えを守るが、ヤンチャな弟兎は一向に母の教えを聞かない。森の悪狐はすきあらばと子兎を狙う。ある日、油断していた子兎達は不意を襲われ、必死に逃げるが、あわやという時、母兎が危機を救う。" ;
    schema:identifier "NAE0537" ;
    schema:name "子うさぎものがたり" ;
    schema:pagination "245" ;
    schema:productionCompany "日動映画" ;
    schema:releaseDate "1954年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0537> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1220>
    rdf:type o:Item, schema:CreativeWork ;
