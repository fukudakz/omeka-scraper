<https://www.nihon-animation-eigashi.com/work-db/api/items/1522>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:51+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "花折り （HANAORI, Breaking of branches is forbidden）" ;
    schema:about "川本喜八郎の人形映画自主製作第一作。京都壬生寺の壬生狂言に題材を得て、酒好きの小坊主が、住職の大切にしていた桜の枝を通りがかりの酔客の大名と供の太郎冠者にだまされて折り盗られるという風狂な話。人形は立体でなくレリ ーフ状で背景の上に置き、カメラは垂直に撮影された。桃山時代の障壁画を模した壬生露彦の美術が見事である。スタジオは劇作家、飯沢匡邸。バックに流れる黒柳徹子の般若心経が面白い。完成試写会は五月十日夜十時から新宿文化地下の蝎座で行われた。" ;
    schema:actors "黒柳徹子" ;
    schema:audio "トーキー" ;
    schema:awards "1968年ママイア国際動画映画祭（ルーマニア）銀賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/14328>, <https://www.nihon-animation-eigashi.com/work-db/item/80045> ;
    schema:color "カラー" ;
    schema:composer "音楽：小森昭宏" ;
    schema:contentType "16mm" ;
    schema:contributor "スチル：ヤマシナ・アツコ", "人形アニメーション：川本喜八郎、及川功一", "効果：ヨシダ・ミノル、高橋巌", "協力：アオヤマ・ヒロコ、伊沢夏男、三角永子、佐藤三郎、吉田悌三、丸山淳子、斎藤浩子、斎藤堅", "撮影：吉岡謙", "演出：川本喜八郎", "照明：野村隆三、タグチ・マサヒロ", "編集：守随房子", "美術：壬生露彦、中川涼", "録音：伊藤一男" ;
    schema:duration "14分" ;
    schema:identifier "NAE0840" ;
    schema:name "花折り （HANAORI, Breaking of branches is forbidden）" ;
    schema:pagination "296" ;
    schema:productionCompany "川本喜八郎" ;
    schema:releaseDate "1968年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0840> ;
    schema:volumeNumber "2" .

