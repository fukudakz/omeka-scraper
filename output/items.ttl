    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "凸之助武勇伝" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：市野正二" ;
    schema:description "鞍馬山の奥深く大天狗について武術を習う少年凸之助は修行のかいあって、ついに恩師の鼻をへし折るまで上達した。師の許しを得て諸国武者修業に旅立つが、道中三人組のゴマのハエのからくりに引っかかり、身ぐるみはがれる。たちまち武勇を発揮し、一味を捕え、城下町の辻にしばりつけ、立札に「コノ三ニンハ、ゴマノハエナレバ、ハエタタキニテタタクベシ」と書置いて旅立つ。" ;
    schema:identifier "NAE0298" ;
    schema:name "凸之助武勇伝" ;
    schema:pagination "217" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0298> ;
    schema:volumeNumber "1" .

