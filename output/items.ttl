<https://www.nihon-animation-eigashi.com/work-db/api/items/1148>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ネズミの拳闘" ;
    schema:about "フジ・フィルム研究所は映画用カラーフィルム（リバーサル）開発後、新映画社と共同でフジ・カラーによる動画の試作品を製作したが、試作品のため一般公開はされなかった。国産初のカラー劇映画は二十六年三月、松竹で公開された木下恵介監督の「カルメン故郷に帰る」が第一号だが、これらの動画試作品はカラー・フィルムの発色テストの基礎となったそうだ。この作品は、二十七年七月、近代映画社から「鼡の拳闘」として発売されている。鼡が猫に立ち向うという内容だが、当時、CIE（駐留アメリカ民間情報教育部）のシナリオの事前検閲で、思想上（猫は大国アメリカを意味するのか?）面白くないとの理由で、製作許可がなかなかおりなかったというエピソードがあったそうだ。" ;
    schema:audio "トーキー" ;
    schema:author "増田謙二" ;
    schema:color "フジカラー" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：里見修", "撮影：浅野恵", "演出：森野佐登志", "脚本：増田謙二" ;
    schema:description "力自慢の鼡が猫に勝とうと猛練習。成果を見せようと仲間の鼡を集め猫とボクシングをする。子猫に紙袋をかぶせてリングで闘うが、紙袋が破れると、子猫でも猫。あまり強いので、鼡達は逃げ出す。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0466" ;
    schema:materialExtent "305m" ;
    schema:name "ネズミの拳闘" ;
    schema:pagination "237" ;
    schema:productionCompany "新映画社、フジ・フィルム研究所" ;
    schema:releaseDate "1948年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0466> ;
    schema:volumeNumber "1" .

