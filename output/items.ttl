    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "汽車の発達" ;
    schema:about "汽車の歴史を実写と動画で説明したもので、アニメの部分は全体の約三分の一。" ;
    schema:alternateName "汽車の發達" ;
    schema:audio "サイレント" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/20067>, <https://www.nihon-animation-eigashi.com/work-db/item/21489> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司", "指導：全日本活映教育研究会", "撮影：飯田光治", "編集：青地忠三" ;
    schema:description "\"本映画は尋常小学校読本巻九「汽車の発達」によりて編む\"とタイトルが出て、ブランカ、ニューコメン、キュニョー、トレビシック、スチーブンソンの蒸気機関の発達を動画で説明。実写でイギリス鉄道百年祭、我国の汽車製造風景などを見せ、再び動画でボギー車の構造、全国に延びる鉄道路線を示す。最後にC51が勇壮に走る。" ;
    schema:disambiguatingDescription "教材・実写併用" ;
    schema:identifier "NAE0210" ;
    schema:name "汽車の発達" ;
    schema:pagination "206" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1932年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0210> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/597>
