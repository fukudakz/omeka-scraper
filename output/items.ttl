    schema:contentType "35mm" ;
    schema:contributor "仕上：本橋文枝", "作画：月岡貞夫、小林知子、花田玲子、林重行、田村真也", "撮影：菅原英明、篠崎文男", "構成・演出：白川大作、月岡貞夫", "監修：森康二", "編集：稲葉郁三", "美術：小山礼司", "脚本：白川大作、月岡貞夫", "録音：石井幸夫" ;
    schema:dateCreated "1961年10月14日" ;
