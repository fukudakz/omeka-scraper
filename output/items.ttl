    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マー坊の大陸秘境探検" ;
    schema:alternateName "マー坊の珍道中" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：佐藤吟次郎、千葉洋路" ;
    schema:description "萬里の長城のかなた、アジア大陸の一角に昔から桃源境として知られる国があった。某国のために国は荒され危機にひんしていた。マー坊はこの国を訪れたがスパイ容疑で投獄される。危機を脱し敵軍を破り国を救う。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0336" ;
    schema:materialExtent "303m" ;
    schema:name "マー坊の大陸秘境探検" ;
    schema:pagination "221" ;
    schema:productionCompany "佐藤映画製作所" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0336> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/723>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マー坊の木下藤吉郎" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/50411> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:description "尾張の国の百姓の子として生れた藤吉郎は大望を抱き国を出る。やはぎ橋で蜂須賀小六に会った後、織田信長に仕える。信長と美濃城主、 斉藤竜興との合戦で洲の俣の築城を完成、斉藤勢を破り出世した。最後にマー坊がおじぎをしてからチョンマゲのかつらを取る。今までの話は全部撮影所で撮っていた映画でありましたというお話。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0337" ;
    schema:materialExtent "315m" ;
    schema:name "マー坊の木下藤吉郎" ;
    schema:pagination "221" ;
    schema:productionCompany "佐藤映画製作所" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0337> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/724>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
