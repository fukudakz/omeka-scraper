    o:title "煙突屋ペロー" ;
    schema:audio "サイレント" ;
    schema:author "田中喜次" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/19596> ;
    schema:color "白黒" ;
    schema:contentType "16mm" ;
    schema:contributor "脚色：田中喜次" ;
    schema:description "煙突屋のペローは小鳥を助け、お礼に兵隊を生み出すという不思議な卵をもらう。ペローの国は外国と戦争し、負けそうになるが、卵から沢山の兵隊を生み出して国を救う。王様から沢山ほう美をもらい、田舎の母のもとに帰る。途中、車窓から見た風景は戦争で荒れ果てていた。やがてクワをかついだペローの姿が畑で見られるようになった。戦争の悲劇を影絵で描いた作品。" ;
    schema:disambiguatingDescription "影絵" ;
    schema:distribution "深田商会" ;
    schema:duration "21分" ;
    schema:identifier "NAE0171" ;
    schema:materialExtent "153m" ;
    schema:name "煙突屋ペロー" ;
    schema:pagination "202" ;
    schema:productionCompany "京都童映社" ;
    schema:releaseDate "1930年" ;
    schema:sourceOrganization "プロキノ" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0171> ;
    schema:volumeNumber "2" .

