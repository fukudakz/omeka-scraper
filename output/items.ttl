<https://www.nihon-animation-eigashi.com/work-db/api/items/758>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:12+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "お蝶夫人の幻想" ;
    schema:about "処女作\"黄金の鈎\"が大好評のため朝日映画社が専属で製作させることになった。プッチーニの有名な歌劇\"蝶々夫人\"の曲を影絵で製作。日本影絵映画の代表的名作といえる。一万八千齣の撮影を終了し、録音の際、著作権を持つプラーゲ博士から破格の上演料を要求され、資金的に支払が困難となった。これを知った三浦環の全面的な協力で、新しい着想のもとに歌詞と新曲が出来、やっと完成したいきさつがあった。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "作詞・独唱：三浦環", "合唱：三浦環声楽団" ;
    schema:contentType "35mm" ;
    schema:contributor "切抜・構成・撮影：荒井和五郎、飛石仲也" ;
    schema:description "緑の季節が来て燕が飛びかう頃、はるか水平線に星条旗をなびかせたリンカーン号が見えた。待ち続けた夫の来訪。しかし幸福はつかの間、夢の様に過ぎ去る。女だけの幸せを胸に秘め桜の様に散り果てる日本娘と米国士官との悲恋を影絵で描いた抒情的な佳作。" ;
    schema:disambiguatingDescription "影絵" ;
    schema:duration "12分" ;
    schema:identifier "NAE0372" ;
    schema:materialExtent "332m" ;
    schema:name "お蝶夫人の幻想" ;
    schema:pagination "224" ;
    schema:productionCompany "朝日映画社" ;
    schema:releaseDate "1940年5月16日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0372> ;
    schema:volumeNumber "1" ;
    schema:workPresented "大勝館", "横浜オデオン座", "武蔵野館", "邦楽座", "銀座映画劇場" .

