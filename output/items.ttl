    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "森の音楽会" ;
    schema:author "西尾善介" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16946>, <https://www.nihon-animation-eigashi.com/work-db/item/20024> ;
    schema:color "カラー" ;
    schema:composer "作曲：尾崎義雄", "演奏：日本フィルハーモニー", "独唱：楠トシエ", "音楽指揮：山本浩久" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：福田里三郎", "監督：芦田いわお", "背景：右田利朗", "脚色：西尾善介", "色彩効果：日本色彩株式会社", "補助動画：西島行雄" ;
    schema:dateCreated "1953年3月" ;
    schema:description "今日は森の音楽会、態度の悪い狼は道路にゴミの山を作って出発。電車の中ではタバコを吸って注意される。タバコを窓から捨てると今度はガソリンスタンドに引火。会場の庭で花を摘むがハチの大襲撃にあう。開演ベルが鳴り、いよいよコンサート、狼の投げた帽子が指揮者の頭に乗り、リズムが狂って歌手が怒り、会場は大混乱。 狼は観客に袋だたきにあう。" ;
    schema:distribution "配給：奥商会" ;
    schema:identifier "NAE0531" ;
    schema:name "森の音楽会" ;
    schema:pagination "244" ;
    schema:productionCompany "芦田漫画映画製作所" ;
    schema:releaseDate "1953年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0531> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1214>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:48+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かかし" ;
    schema:author "栗原一登" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/32943> ;
    schema:color "白黒" ;
    schema:contentType "16mm" ;
    schema:contributor "作画・演出：芦田いわお", "脚本：栗原一登" ;
    schema:dateCreated "1953年5月" ;
    schema:description "稲田の中に今日も立っているかかし。突然の激しい風に吹きとばされ、糸の切れたタコの様に大空高く舞い上った。かかしは白い雲のひげにつかまったり、杉の梢にすがりついたりして助けを求めるが、空のかなたへ消えてしまう。もう一度村へ帰りたいと“の”の字の目から涙をボロボロ流して泣いていた。これを見つけたツバメ親子が同情して仲間を集め、列をつくりかかしを乗せて村へ飛び立った。" ;
    schema:distribution "配給：奥商会" ;
    schema:identifier "NAE0532" ;
    schema:name "かかし" ;
    schema:pagination "244" ;
    schema:productionCompany "芦田漫画映画製作所" ;
    schema:releaseDate "1953年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0532> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1215>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "小人の電話" ;
    schema:about "電気通信省が電電公社となってからのサービスぶりを紹介、併せて自動電話の正しいかけ方のPR映画。動画と実写の合成が珍らしい。" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/23617>, <https://www.nihon-animation-eigashi.com/work-db/item/23632> ;
    schema:color "フジカラー" ;
    schema:contentType "35mm" ;
    schema:contributor "出演：池真理子、真弓田一夫", "動画監督：薮下泰司", "脚本：秋元憲 実写監督：秋元憲" ;
    schema:correction "製作を更新 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:dateCreated "1953年4月17日" ;
    schema:description "小人島に電話器が流れつく。この電話器を分解。小人国でも電話をつけることになる。王様が第一声を試験するが、雑音ばかりで、担当の電話大臣は大弱り。大臣の息子と王様の姫は婚約中だが、この一件でキャンセル。一方、大臣と息子や技術者は電話先進国に視察に向う。小人国の姫は婚約を解消され病気になり明日の命が判らない。調査団は急ぎ帰国、電話も無事開通し、姫も元気になりメデタシとなる。" ;
    schema:disambiguatingDescription "実写合成" ;
    schema:identifier "NAE0533" ;
    schema:name "小人の電話" ;
    schema:pagination "244" ;
    schema:productionCompany "東光映画、日動映画、渡部プロダクション" ;
    schema:releaseDate "1953年" ;
    schema:sourceOrganization "日本電信電話公社" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0533> ;
    schema:volumeNumber "3" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1216>
