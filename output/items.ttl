<https://www.nihon-animation-eigashi.com/work-db/api/items/562>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:07+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "難船ス物語 第一篇 猿ケ島" ;
    schema:about "政岡憲三の第一回作品。" ;
    schema:author "清水秀雄" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "監督：政岡憲三", "脚色：清水秀雄" ;
    schema:description "海は暴風雨だった。帆船の船長夫婦はせめて子供だけでも助けようと、赤ん坊を箱に入れて流した。赤ん坊の箱は幸いにもある島へ流れついた。その島には猿しか住んでいなかった。猿達は赤ん坊を自分の先祖と思い大切に育てる。しかし赤ん坊が成長するにつれ尻尾が生えてこないので猿達は子供をいじめた。子供は猿達をやっつけ高い崖から海へ飛び込み、イカダを作って島を逃げ出す。" ;
    schema:identifier "NAE0176" ;
    schema:name "難船ス物語 第一篇 猿ケ島" ;
    schema:pagination "203" ;
    schema:productionCompany "日活太秦漫画映画部" ;
    schema:releaseDate "1930年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0176> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/563>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:media <https://www.nihon-animation-eigashi.com/work-db/api/media/846> ;
    o:modified "2026-04-01T04:33:38+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:primary_media <https://www.nihon-animation-eigashi.com/work-db/api/media/846> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ちょん切れ蛇" ;
    schema:actors "科白吹き込み：大辻司郎" ;
    schema:audio "トーキー（インターナショナル録音装置）" ;
    schema:author "前川千帆" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/T0005> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・撮影：幸内純一" ;
    schema:dateCreated "1931年" ;
    schema:description "春、穴からはい出した蛇の胴は真中から切れていた。胴の切口から呑まれた蛙が飛び出し、目の前に大きな蛇がいるので驚く。蛇は蛙に命じ、穴に残った尻尾を呼びにやる。尻尾に入った蛙と蛇が大格闘を演じ、ボール投げで勝負を決する。 蛙の投げたボールが蛇の口に入ると、腹の中から、先にのまれていた蛙が、四、五匹出て来る。蛇は空腹のあまり自分の尻尾をのみこむと、うまく胴体がつながった。" ;
    schema:distribution "第一映画社" ;
    schema:duration "4分" ;
    schema:identifier "NAE0177" ;
    schema:materialExtent "122m" ;
    schema:name "ちょん切れ蛇" ;
    schema:pagination "203" ;
    schema:productionCompany "スミカズ映画創作社" ;
    schema:releaseDate "1932年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0177> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/564>
