<https://www.nihon-animation-eigashi.com/work-db/api/items/1479>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "北風のくれたテーブルかけ" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/14221>, <https://www.nihon-animation-eigashi.com/work-db/item/15543>, <https://www.nihon-animation-eigashi.com/work-db/item/20277> ;
    schema:color "フジカラー" ;
    schema:composer "音楽：小林亜星" ;
    schema:contentType "16mm" ;
    schema:contributor "人形アニメーション：和田京子、安藤映子、武川和子", "人形：紙谷元子", "撮影：八木正次郎、阿部行雄", "美術：中川涼", "脚本・演出：渡辺隆平", "製作担当：神保まつえ", "製作：原正次" ;
    schema:dateCreated "1967年3月" ;
    schema:description "少年ハンスが納屋へ粉を取りに行くと北風が粉を吹き飛ばす。ハンスは北風を訪ねて文句を言うと、北風はご馳走を出すテーブルかけをくれた。帰り道、夜になり宿に泊ったハンスのテーブルかけを、ずるい主人が取り代えてしまう。それと知らず、ハンスは北風にもう一度文句を言いに行く。今度は金貨を出す羊をくれるが、再び宿屋の主人に取りかえられる。今度は北風に一本の枝をもらう。この枝でずるい主人はひどい目に遭う。ノルウェーの古い昔話の人形映画化。" ;
    schema:duration "15分" ;
    schema:identifier "NAE0797" ;
    schema:name "北風のくれたテーブルかけ" ;
    schema:pagination "288" ;
    schema:producer "石川茂樹" ;
    schema:productionCompany "学研映像局" ;
    schema:releaseDate "1967年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0797> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1480>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マッチ売りの少女" ;
    schema:about "アンデルセン原作の人形映画化。夢の場面を作るためにセット上に薬品を並べたり化学実験めいたテストがされたそうだが、結局、色紙を使用した。雪も降る雪と、屋根に積った雪、道路に凍りついた雪とそれぞれ区別したそうだ。" ;
    schema:actors "内村軍一、須永宏、関根信昭、加藤玉枝、里見京子、坂本和子、伊島幸子、新道乃里子、飯田桂子" ;
    schema:audio "トーキー" ;
    schema:author "アンデルセン" ;
    schema:awards "第二十一回日本映画技術賞（撮影：平井寛）", "第二十二回毎日映画コンクール教育文化映画賞", "第二十二回芸術祭奨励賞", "第二回青少年映画賞", "第十五回キネマ旬報文化映画ベスト・テン第二位", "第十四回教育映画祭最高賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/10674>, <https://www.nihon-animation-eigashi.com/work-db/item/10811>, <https://www.nihon-animation-eigashi.com/work-db/item/14056>, <https://www.nihon-animation-eigashi.com/work-db/item/14963>, <https://www.nihon-animation-eigashi.com/work-db/item/80110> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：林光" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーター：見米豊、武川和子", "人形：佐々木章", "撮影助手：阿部行雄", "撮影：平井寛", "演出：渡辺和彦", "現像：東洋現像所", "美術：中川涼", "製作担当・脚本：神保まつえ", "製作：原正次", "録音：アオイスタジオ" ;
    schema:dateCreated "1967年7月" ;
    schema:description "大みそかの寒い夜、貧しい少女が町角でマッチを売っていたが、ちっとも売れない。道を横切ろうとした時、馬車をよけそこね、はいていた靴をなくす。雪が降り始めたが、父から「マッチが売れないうちは家に帰るな」と、きつく言われているので帰れない。少女は雪をよけて建物の間にうずくまった。手足はすっかり凍えて動けなくなった。少女は商売用のマッチを一本すって暖を取った。次のマッチをすった時、暖い炎の中に楽しい世界を見ることが出来た。三本、四本とすっているうちに、自分を可愛がってくれた天国のおばあさんに会うことが出来た。大好きなおばあさんの姿が消えないように、次から次へとマッチをすり続けた。翌朝、凍死した少女を発見した人々は少女の死を憐れんだ。" ;
    schema:duration "18分" ;
    schema:identifier "NAE0798" ;
    schema:materialExtent "493m" ;
    schema:name "マッチ売りの少女" ;
    schema:pagination "288" ;
    schema:producer "石川茂樹" ;
    schema:productionCompany "学研映像局" ;
    schema:releaseDate "1967年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0798> ;
    schema:volumeNumber "2" .

