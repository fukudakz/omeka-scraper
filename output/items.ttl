<https://www.nihon-animation-eigashi.com/work-db/api/items/1312>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "二匹のサンマ" ;
    schema:about "久里洋二、柳原良平、真鍋博のデザイナー、漫画家など新鋭三人グループで結成された“アニメーション三人の会”第一回発表会（11月26日東京・草月ホール）で公開された作品。四十三年にカラーで再製作された。原作の漫画集「二匹のサンマ」（COO2）が三十四年に出版されている。" ;
    schema:author "久里洋二" ;
    schema:color "白黒" ;
    schema:composer "音楽：秋山邦晴" ;
    schema:contentType "16mm" ;
    schema:contributor "動画・撮影・演出：久里洋二", "彩画：足立登美枝", "編集：守随房子", "詩：谷川俊太郎", "録音：奥山重之助", "音響：秋山邦晴" ;
    schema:description "孤島に漂着した男と女（夫婦?）の単調な生活。女はサンマを焼き続ける毎日。ある日、科学者がやって来て新発明の物資生産機で物を続々造り出す。ゴールド・ラッシュみたいに人々がやって来て、島はアッという間にビル・ラッシュ。おきまりの戦争が起こり島は目茶目茶。裸になった島では生き残った元の男女が相変らずサンマを 焼いている。秋山邦晴のミュージック・コンクレート風のサウンドが評判になった。" ;
    schema:duration "20分" ;
    schema:identifier "NAE0630" ;
    schema:name "二匹のサンマ" ;
    schema:pagination "260" ;
    schema:productionCompany "久里実験漫画工房" ;
    schema:releaseDate "1960年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0630> ;
    schema:volumeNumber "2" .

