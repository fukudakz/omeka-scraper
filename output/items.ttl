    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "白蛇伝" ;
    schema:about "日本での最初の記念すべき本格的な色彩長編動画。白蛇の化身、白娘と恋人許仙の愛の物語。" ;
    schema:actors "森繁久弥（東宝）、宮城まり子（東宝）" ;
    schema:audio "トーキー" ;
    schema:awards "1958年度NHK映画祭ベスト・テン別格", "ベルリン国際映画祭文化賞", "メキシコ映画祭名誉大賞", "第11回ベネチア国際映画祭グランプリ", "第13回文部省芸術祭奨励賞", "第13回毎日映画コンクール特別賞", "第5回北海道新聞映画賞特別賞", "第9回ブルー・リボン特別賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/11180>, <https://www.nihon-animation-eigashi.com/work-db/item/16034>, <https://www.nihon-animation-eigashi.com/work-db/item/18601> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：木下忠司、池田正義、鏑木創" ;
    schema:contentType "35mm" ;
    schema:contributor "トレース・彩色：進藤みつ子、山田みよ、伊藤澄子、本橋文枝、宮崎正子", "動画：大塚康生、坂本雄作、喜多真佐武、紺野修司、中村和子、寺千賀雄、楠部大吉郎、長沼寿美子、藤井武、加藤洋子、松隈玉江、赤坂進 〔タイトルには出て来ないが動画に従事したスタッフ〕 中谷恭子、永沢詢、奥山玲子、小田克也、石井元明、野沢和夫、杉山卓、桜井百合緒、大田朱美、生野徹太、堰合昇、市村純子、島村達雄、烏丸軍雪、山室正雄、勝田稔男、元藤郁子、笠井晴子、高松新八郎、相磯嘉雄、石野佳子、福島信行、渡辺保三郎、関口正子、高尾研三、市堀千恵子、太宰真知子、杉井儀三郎、吉田迪彦、堀川豊平、江藤昌治", "原案：上原信", "原画：大工原章、森康二", "台詞構成：矢代静一", "撮影：塚原孝吉、石川光明", "構成・美術：岡部一彦、橋本潔", "編集：宮本信太郎", "背景：草野和郎、前場孝一", "脚本・演出：薮下泰司", "製作：大川博", "進行：稲田伸生", "録音：森武、小松忠之", "音響効果：吉武富士夫", "風俗考証：杉村勇造" ;
    schema:dateCreated "1958年9月3日" ;
    schema:duration "1時間18分" ;
    schema:identifier "NAE0603" ;
    schema:materialExtent "2148m" ;
