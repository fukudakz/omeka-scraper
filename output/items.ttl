<https://www.nihon-animation-eigashi.com/work-db/api/items/620>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:08+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "沼の大将" ;
    schema:about "「蛙三勇士」姉妹編。沼のギャング、ナマズのナマ公は沼の魚を食べて沼を征服、英雄気取りである。ある日、捕えたオタマジャクシから、川を下って海へ出るとおいしい魚がいると聞いて、武者修業を思い立ち、広い海へ旅立つ。海中には 魚は沢山いたが、ナマズほどの大魚はいないと自慢している。ところが、島の様な怪物が出現。怪物は鯨で、驚いたナマ公一目散に沼へ逃げ帰る。 うそつきのオタマ出て来いとどなると、成長した蛙が現われ、反対に退治される。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：大藤信郎", "録音：新田発声映画研究所" ;
    schema:distribution "提供：中央トーキー・スタヂオ", "配給：三映社" ;
    schema:identifier "NAE0234" ;
    schema:name "沼の大将" ;
    schema:pagination "209" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1933年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0234> ;
    schema:volumeNumber "1" .

