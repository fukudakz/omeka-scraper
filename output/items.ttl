    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "荒鷲" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：木村白山" ;
    schema:description "日本空軍の陸の荒鷲は中国の制空権を握って、今日も精鋭が編隊で敵陣を爆撃。敵機を撃墜、その上飛行場に着陸、格納庫、敵機を焼払い、蒋介石の頭上に投降勧告状をまいて帰還する。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0338" ;
    schema:materialExtent "274m" ;
    schema:name "荒鷲" ;
    schema:pagination "221" ;
    schema:productionCompany "佐藤映画製作所" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0338> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/725>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "空の荒鷲" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：大藤信郎" ;
    schema:description "ちんころ平々は海の荒鷲の勇姿を見て自分も飛行機に乗りたくなり、狸のタヌ助をお供に、車回しの小鼡をエンジンとした飛行機で敵地へ出発。わが海の荒鷲が敵の豚機と大激戦の最中、応援に行こうとするとポパイやスターリンの形をした雲が妨害する。その雲を突き抜け敵機と出会うが、機関銃を持たぬちんころ機、敵の機銃を奪い戦う。弾丸がなくなれば肉弾攻撃。遂に敵機は退散しはじめるが、ちんころ機は投縄で捕獲、めでたく帰還する。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0339" ;
    schema:materialExtent "255m" ;
    schema:name "空の荒鷲" ;
    schema:pagination "221" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0339> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/726>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "笑へ山男" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：大藤信郎" ;
    schema:description "団子兵衛が街道を行くと女の悲鳴。助けてやろうと猪の背に飛びのるが、猪反対の方向へ突進。空高く投げ飛ばされた村人が騒動はあちらだと教える。団子兵衛、団子を取り出し、猪にあちらだと団子を投げる。ようやく騒動の場所に来てみると山男の九呂三が村の娘おそでをさらって逃げようと村人達と争っている。山男があまり強いので、かなわぬと見た団子兵衛、笑わせ薬をのんで立ち向い、刀の先から出る笑いの電気で山男を笑い倒し、おそでを救う。" ;
    schema:duration "7分" ;
    schema:identifier "NAE0340" ;
    schema:materialExtent "179m" ;
    schema:name "笑へ山男" ;
    schema:pagination "221" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0340> ;
    schema:volumeNumber "1" .

