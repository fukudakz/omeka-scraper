    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "躍るエンジン" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：熊川正雄、酒井七馬", "撮影：木村角山", "演出：人見吉之助" ;
    schema:description "ケン坊は近代科学を集めた工場の工場長。リズムにのって動く沢山の機械。そこへ三匹の鼡が出て来て機械のハンドルやスイッチにいたずらし工場内の機械は大活動。いたずらが過ぎた鼡は飛行機にのりルーズベルトとチャーチルのポスターに衝突。憤慨したポチは機関銃でポスターを撃つ。ポスターの二人は大あわて。" ;
    schema:duration "8分" ;
    schema:identifier "NAE0403" ;
    schema:materialExtent "227m" ;
    schema:name "躍るエンジン" ;
    schema:pagination "228" ;
    schema:productionCompany "日本映画科学研究所" ;
    schema:releaseDate "1942年10月22日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0403> ;
    schema:volumeNumber "1" ;
    schema:workPresented "銀座ニュース劇場" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/789>
