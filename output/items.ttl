<https://www.nihon-animation-eigashi.com/work-db/api/items/488>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:05+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "珍説・吉田御殿" ;
    schema:about "この映画には「呑気放亭」の副題があり、 ドンキホーテの日本版である。" ;
    schema:alternateName "武者修業物語 [改題]" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "大藤信郎" ;
    schema:correction "別バージョンを関連付け [R6 メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "百姓の子、団子兵衛は出世しようと武者修行の旅に出る。山中で狼の大群に出あい、辻堂に逃げこむ。狼が去った後、腰元が来て、姫の危難を救ってくれと祈る。これを聞いた団子兵衛は一計を案じ、神様の声色を使い、お城に団子兵衛という勇者が姫を助けに行くと告げる。翌日、城まで行ってみると、城内に妖怪変化が住むという噂の吉田御殿だった。恐れをなして逃げ帰ろうと するが、迎えの者に見つかり、城主から姫を助けてくれと頼まれる。化物の住みつく洞穴に入ってみると、横取右衛門という武士が既に捕まっていたので助けてやる。団子兵衛が化物と戦っている間に、一方の武士は姫を救出し、自分が姫を助たと報告し、婿になりすます。やっと化物を退治し御殿へ帰って、ことの成り行きを説明するが、 信じてもらえず、かえって城中から放り出され、 失意のまま故郷に帰る。武士になる大望は捨て、 元の百姓に戻る。" ;
    schema:distribution "中央映画社" ;
    schema:identifier "NAE0102" ;
    schema:isRelatedTo <https://www.nihon-animation-eigashi.com/work-db/api/items/519> ;
    schema:name "珍説・吉田御殿" ;
    schema:pagination "197" ;
    schema:productionCompany "大藤信郎プロダクション" ;
    schema:releaseDate "1928年4月27日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0102> ;
    schema:volumeNumber "3" ;
    schema:workPresented "帝国館", "新宿松竹館", "武蔵野館" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/489>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:05+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "きりぬき浦島" ;
    schema:about "実写のスチルの上に千代紙をはりつけて作られた動画。" ;
    schema:audio "レコード・トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "大藤信郎" ;
    schema:description "千代紙の撮影所の物語。人気スター黒田横造は今回の主役は自分だと思っていた。ところが、意外にも監督の底男は、団子兵衛に浦島太郎の主役を命じた。面白くない横造は、撮影の妨害をもくろむ。撮影は順調に進行し、亀を助けた太郎は竜宮城へ連れて行かれる。乙姫様は歓迎パーティを開き、小魚、フグ、亀とイカのダンスや、タコのバレー等がくりひろげられる。踊りが最高潮に達し、監督やスタッフもつい、つりこまれ踊り出し撮影所の外に出る。このすきに横造は乙姫役の女優をさらって逃げるが、悲鳴を聞いた団子兵衛が追っかけ、大格闘の末、女優を救う。踊りの連中は海中に入り、本当の竜宮城へ向かった。" ;
    schema:distribution "中央映画社" ;
    schema:identifier "NAE0103" ;
    schema:name "きりぬき浦島" ;
    schema:pagination "197" ;
    schema:productionCompany "大藤信郎プロダクション" ;
    schema:releaseDate "1928年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0103> ;
    schema:volumeNumber "3" .

