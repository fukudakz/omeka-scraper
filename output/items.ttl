    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "もぐらのモトロ" ;
    schema:audio "トーキー" ;
    schema:color "イーストマン・カラー" ;
    schema:contentType "35mm" ;
    schema:contributor "作画監督：森康二", "原画：永沢詢", "撮影：林昭夫", "演出：池田宏", "脚本：原徹", "録音：石井幸夫" ;
    schema:dateCreated "1962年7月19日" ;
    schema:description "モグラのいたずらが原因で狐と狸がモグラと大喧嘩。モグラのモトロが詫びを入れたが聞いてもらえず、彼のおかげで命を得たワラ人形が見かねてとりなしてくれる。スピーディーな筋運びの佳作。" ;
    schema:duration "15分" ;
    schema:identifier "NAE0660" ;
    schema:materialExtent "407m" ;
    schema:name "もぐらのモトロ" ;
    schema:pagination "265" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1962年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0660> ;
    schema:volumeNumber "2" .

