    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "太郎の夢" ;
    schema:about "〔解説〕ポリドール・レコード338A・B面にシンクロする。協力映画社第五回作品。後にフィルム式トーキー版「無敵総動員」と改題され、何度も再版されている。\n〔内容〕太郎は夢で軍人になり、オモチャ箱から出て来た義経、桃太郎、金太郎、キューピー、オモチャの兵隊たちを引き連れて満洲で支那兵を潰滅し、目出度く凱旋する。" ;
    schema:alternateName "無敵総動員" ;
    schema:audio "レコード・トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "加藤禎三", "滝多夕寿", "西倉喜代治" ;
    schema:duration "10分" ;
    schema:identifier "NAE0220" ;
    schema:materialExtent "189m" ;
    schema:name "太郎の夢" ;
    schema:pagination "208" ;
    schema:productionCompany "協力映画社" ;
    schema:releaseDate "1932年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0220> ;
    schema:volumeNumber "1" .

