    o:title "空の慰問隊" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：酒井七馬" ;
    schema:description "ケン坊は街路やゴミ箱に捨てられた廃品で立派な飛行機を作り、世界無着陸飛行を敢行。途中悪天候と戦い、欧州では独・伊軍の活躍、撃墜される米英の飛行機を見る。中国大陸では日本軍に護られた中国の子供達にお土産をやり、日本の兵隊には慰問袋を送る。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0405" ;
    schema:materialExtent "250m" ;
    schema:name "空の慰問隊" ;
