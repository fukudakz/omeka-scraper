    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "雪の夜の夢" ;
    schema:about "アンデルセンの\"マッチ売りの少女\"の物語を、舞台を中国風にした影絵で、二重露出や重ね焼きの技術を使って美しく幻想的に仕上げている。人物が大藤氏独特の気味の悪い動き方をするのが印象的で、終わりが取って付けたようなハッピー・エンドになるのが気になる。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17372> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：大藤信郎" ;
    schema:description "雪の降る夜、少女はロウソク売りに歩くが誰も買ってくれない。ある家を窓から覗くと、親と子が幸福そうに暮らしている。力がつき、道路に倒れるが、幻の母が現れ、夢の中で母と一緒に戯れる。気がつくと、母は消え、親切な人に助けられる。" ;
    schema:disambiguatingDescription "影絵" ;
    schema:distribution "三幸映画社" ;
    schema:duration "10分" ;
    schema:identifier "NAE0446" ;
    schema:materialExtent "261m" ;
    schema:name "雪の夜の夢" ;
    schema:pagination "235" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1947年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0446> ;
    schema:volumeNumber "1" .

