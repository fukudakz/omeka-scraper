    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マー坊の東京オリンピック大会" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16972-2> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "佐藤吟次郎", "千葉洋路" ;
    schema:description "マー坊少年はオリンピックで水陸各競技全部の選手権を取ろうと動物園の動物をコーチに猛練習。トラックは蛇鳥。フィールドは象、カンガルー、猿。飛込みはペンギン。水泳はアザラシといった名コーチ。大会当日、マー坊は動物達がくれた \"必勝丸\"をのんで出場。各種競技に優勝し日の丸をかかげる。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0311" ;
    schema:materialExtent "303m" ;
    schema:name "マー坊の東京オリンピック大会" ;
    schema:pagination "218" ;
    schema:productionCompany "佐藤線映画製作所" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0311> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/698>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "森の小兎" ;
    schema:about "東京学校巡回映画連盟伴奏委員の関猛の原作による小兎シリーズ、第一編。" ;
    schema:author "関猛" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：西倉喜代治、殿谷正丈、加東てい象", "脚色：関猛" ;
    schema:description "森の朝、小兎は花園で草花とラジオ体操、朝の散歩に出かけ迷子の小豚を助ける。ある日、小兎は象のところへ行き、豚親子が沼に落ちて困っているから助けてくれと言葉巧みに頼む。象は小兎の言葉を信じ豚を助ける事を承知する。小兎は今度は鯨のところへ行き、象が沼に落ちて困っているので助けてくれと頼む。鯨も象を助ける事になり、小兎は用意した綱で象と鯨に綱引きさせた。森の動物総動員で象に加勢。鯨も沢山の魚の応援を得て、象も鯨も小兎の言葉を信じたため一生懸命綱を引張るが、とうとう綱は切れる。" ;
    schema:identifier "NAE0312" ;
    schema:name "森の小兎" ;
    schema:pagination "219" ;
    schema:productionCompany "オールキネマ社" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0312> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/699>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "小兎の天空旅行" ;
    schema:about "小兎シリーズ第二編。" ;
    schema:alternateName "ウサ公の宇宙旅行" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16582-2> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "西倉喜代治" ;
    schema:description "小兎は森の動物達に見送られ、当時流行した小型飛行機・空の嵐（プー）に乗って天空旅行に出発。先ず火星で無重力を楽しんでいると、ゴリラの体に豚の鼻、象の耳の怪物に追いかけられる。次に月に到着、兎たちに迎えられて月の宮殿に行き、王女様と並んで兎たちのダンスを観る。この場面は村田安司の「月の宮の王女様」とそっくり。浮かれて雲から足を踏みはずし、地球の森の中に落ち、豚達と家に帰る。" ;
    schema:identifier "NAE0313" ;
    schema:name "小兎の天空旅行" ;
    schema:pagination "219" ;
    schema:productionCompany "オールキネマ社" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0313> ;
    schema:volumeNumber "1" .

