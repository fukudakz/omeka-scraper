<https://www.nihon-animation-eigashi.com/work-db/api/items/10>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-01-25T10:57:20+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:04+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "塩原多助" ;
    schema:audio "サイレント" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "木村白山" ;
    schema:correction "音声を追加、別バージョンを関連付け [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "父を失った多助は、継母に仕え、朝早くから夜遅くまで働いた。継母の命令で隣村まで麦を届けに行く途中、継母の回し者の待ち伏せに合うが、愛馬あおによって一命を救われる。このまま村に居ると村人の迷惑になると考え、多助はあおと別れ江戸へ旅立つ。働くあても金もない。困ったあげく、両国橋から身投げを計るが、ちょうど通りかかった炭屋の主人に助けられ、その店で働くことになる。根っからの勤勉さが買われて、 多助はその家の娘を嫁にもらい、幸福に暮らす。 己を捨て勤倹貯蓄に励むべきを訴える教訓動画。" ;
    schema:identifier "NAE0048" ;
    schema:isRelatedTo <https://www.nihon-animation-eigashi.com/work-db/api/items/11>, <https://www.nihon-animation-eigashi.com/work-db/api/items/12> ;
    schema:name "塩原多助" ;
    schema:pagination "194" ;
    schema:productionCompany "朝日キネマ" ;
    schema:releaseDate "1925年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0048> ;
    schema:volumeNumber "2" .

