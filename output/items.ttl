    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "芋と兵隊" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "福田宗吉" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・撮影：片岡芳太郎", "後援：陸軍省報道部", "装置：北村義雄", "製作：塚本嘉次郎" ;
    schema:correction "作者・スタッフを更新 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "砲弾の雨をくぐり、山また山を縫って地上部隊は進撃する。食料も欠乏するが芋をふかし野営。歌も出る。暁の夢を破り大激戦の火ブタは切られ、荒鷲の敵陣猛爆撃も始まる。敵も反撃するが我軍も突撃し敵の堅陣は落ち日の丸が高く揚がる。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0406" ;
    schema:materialExtent "293m" ;
    schema:name "芋と兵隊" ;
    schema:pagination "228" ;
    schema:productionCompany "塚本興業" ;
