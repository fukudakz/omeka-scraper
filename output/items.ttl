<https://www.nihon-animation-eigashi.com/work-db/api/items/721>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:11+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "源九郎義経" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "山本早苗" ;
    schema:description "源義経の一代記を動画化したもの。七才の時、義経は鞍馬山に入り、大天狗の指導により武道にはげんだ。その頃、京の五条大橋に弁慶と呼ばれる怪盗が出現、義経は橋上で弁慶と闘い家来にした。成長し兄頼朝の手足となり、平家の軍を破り、ヒヨドリ越の逆落しをかけ、ついに平家壊滅の因を作る。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0335" ;
    schema:materialExtent "245m" ;
    schema:name "源九郎義経" ;
    schema:pagination "221" ;
    schema:productionCompany "奥商会" ;
    schema:releaseDate "1938年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0335> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/722>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
