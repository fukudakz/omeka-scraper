<https://www.nihon-animation-eigashi.com/work-db/api/items/1460>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-04T05:33:03+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "サイボーグ009（ゼロゼロナイン）" ;
    schema:about "従来の東映動画は一時間半以内のA級動画を製作していたが、一時間以内のB級を製作することになった第一号。トレスに初めてゼロックスを使用。東映動画ではゼログラフィの呼称だが、人件費節約と製作コストの軽減をはかった。 \n少年漫画の石森章太郎のヒット作の動画化で世界各国のサイボーグ九人が結集して、死の商人、世界の平和を乱す悪の組織ブラック・ゴースト団に決戦を挑む。画面いっぱいのジェット機の空中戦、ミサイル戦、多数の艦船が入り乱れての海戦などアクション中心のSF動画。" ;
    schema:actors "[009（日本人）] 太田博之、[008（アフリカ人）] 内海賢二、[007 （イギリス人）] 曽我町子、[006（中国人）] 藤村有弘、[005（アメリカインディアン）] 増岡弘、[004（ドイツ人）] 大竹宏、[003（フランス人）] ジュディ・オング、[002 （アメリカ人）] 石原良、[001（ロシア人の赤ん坊）] 島山京子、[ギルモア博士] 八奈見乗児、[ブラック・ゴースト団首領] 山内雅人、[ビーグル（B・G団副首領）] 川久保潔、[エーゼル（ビーグルの手下）] はせ・さんじ", "ナレーター：黒沢良" ;
    schema:audio "トーキー" ;
    schema:author "石森章太郎" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/10553>, <https://www.nihon-animation-eigashi.com/work-db/item/18089>, <https://www.nihon-animation-eigashi.com/work-db/item/25300> ;
    schema:color "カラー" ;
    schema:composer "小杉太一郎" ;
    schema:contentType "35mm" ;
    schema:contributor "ゼログラフィー：加藤稔", "トレス：植木知子、市村和子", "仕上検査：小椋正豊、西元敦子", "作画監督：木村圭一郎", "動画：桜井勇、平村文男、鹿島恒保、山田一広、岩塚美子、玉沢武、榎本有也、大崎道泰、内田君子", "原画：上村栄司、若林哲弘、森下圭介、高橋信也、大橋学、椛島義夫", "彩色：赤荻永江、古屋純子", "撮影：平尾三喜", "演出助手：宮崎一哉", "演出：芹川有吾", "特殊効果：岡田良明、高橋佳子", "編集：千蔵豊", "美術：沼井肇", "背景：佐々木耕成、篠田洋子、渡辺俊児", "脚本：飯島敬、芹川有吾", "色彩設計：辻忠直", "製作進行：堤四四三", "製作：大川博", "記録：中垣禧代", "録音：小西進", "音響効果：大平紀義" ;
    schema:disambiguatingDescription "東映スコープ" ;
    schema:duration "1時間4分" ;
    schema:identifier "NAE0778" ;
    schema:isBasedOn "『少年キング』連載" ;
    schema:materialExtent "1751m" ;
    schema:name "サイボーグ009（ゼロゼロナイン）" ;
    schema:pagination "282" ;
    schema:producer "関政治郎、平沢明、飯島敬、旗野義文" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1966年7月21日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0778> ;
    schema:volumeNumber "6" ;
