<https://www.nihon-animation-eigashi.com/work-db/api/items/1461>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "少年ジャックと魔法使い" ;
    schema:about "東映動画創立十周年記念として製作された。当初の題名は「不思議な世界の大冒険」。久しぶりの薮下演出で、北欧の悪魔を退治する騎士の武勲をたたえる叙事詩にヒントを得たもの。第二十二回毎日映画コンクール音楽賞が作曲の宇野誠一郎に与えられた。動画の音楽に評価が与えられ、受賞したのはこれが最初で記念すべき出来事である。" ;
    schema:actors "[少年ジャック、悪魔の少女キキー] 中村メイコ、[キキーの弟シバリ] 久里千春、[ネズミ] 黒柳徹子、[子熊] 熊倉一雄、[キツネ] 大竹宏、[子犬] 水垣洋子、[魔女グレンデル] 山岡久乃、[小悪魔A、B、C、D、E、F] 伊藤牧子、湯浅実、中川謙二、山本喜代子、芳川和子、[その他] 八奈見乗児、野沢雅子、山本圭子、増岡宏、栗葉子、北川真理、山岸比呂美、近藤高子、三十人会" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/12998>, <https://www.nihon-animation-eigashi.com/work-db/item/17583> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "主題歌作詞：井上ひさし、山元護久", "作曲：宇野誠一郎", "唄：中村メイコ、黒柳徹子、熊倉一雄、大竹宏、水垣洋子、ボーカルショップ、ボーチェアンジェリカ", "音楽：宇野誠一郎" ;
    schema:contentType "35mm" ;
    schema:contributor "ゼログラフィ：松本寿夫", "トレース：武田澄子、黒沢和子", "仕上検査：新納三郎、新開甫", "作画監督：大工原章", "動画：斎藤智、藤本芳弘、笠井晴子、花田玲子、篠原征子、小林敏明、飯田銈一、斎藤瑛子、柴田圭子、白石基子、阿久津文雄、浅田清隆、富永勤、正井融、佐々木章、小川明弘、堀池義治、田村真也、草間真之介、長沼寿美子", "原画：古沢秀雄、小田克也、森英樹、平川謹之介、竹内留吉、金山通弘、木野達児、松原明徳", "彩色：中林伸子、関口雅子", "撮影：菅原英明", "演出助手：村山鎮雄、葛西治", "演出：薮下泰次", "特殊效果：林富喜江、平尾千秋", "編集：千蔵豊", "美術：小山礼司", "背景：杉本英子、遠藤重義、片倉和子、小林七郎", "脚本：関沢新一、高久進", "製作進行：古沢義治", "製作：大川博", "記錄：的場節代", "録音：石井幸夫", "音響効果：大平紀義" ;
    schema:dateCreated "1966年9月" ;
    schema:description "主人公のわんぱく少年ジャックが、不思議な世界に住む魔女の妖術で小悪魔にされた子供達（発想は“ヘンゼルとグレーテル”だろう）を救うため、動物たちと悪魔の城に乗りこみ、魔女と戦う。ジャックを襲う巨大な植物や昆虫、化物がさまよう死の世界、巨大な白骨の原始怪獣などにうち勝ち子供達を救い出す。魔女の乗物もホウキならぬヘリコプターと現代的な設定だ。" ;
    schema:disambiguatingDescription "東映スコープ" ;
    schema:duration "1時間20分" ;
    schema:identifier "NAE0779" ;
    schema:materialExtent "2197m" ;
    schema:name "少年ジャックと魔法使い" ;
    schema:pagination "283" ;
    schema:producer "関政次郎、茂呂清一、有賀健" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1967年3月19日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0779> ;
    schema:volumeNumber "8" ;
    schema:workPresented "東映系" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1462>
