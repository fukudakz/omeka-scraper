<https://www.nihon-animation-eigashi.com/work-db/api/items/106>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-01-26T14:49:55+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:05+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "鯨" ;
    schema:about "ドイツの影絵映画「カリフの鶴」に影響を受け製作した切抜き影絵映画。後年カラーセロファンを使用し、色彩で再製作する。ヴィクターレコード「ウィリアムテル」A・B・A面にシンクロする。" ;
    schema:audio "レコード・トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "大藤信郎" ;
    schema:description "暴風雨の大海原で商人、武士、美しい娘らを乗せた船が難破した。翌朝は晴れるが、船の破片に生き残った三人の船頭と美しい娘がいた。 漂流中も男達は娘目当てに争った。突然、大鯨が現われ、四人をのみこむ。腹の中では、娘の事も忘れ、逃げるのに必死になる。鯨が潮を吹き上げたため、四人は鯨の背の上に投げ出される。娘も助かったとみると、男達は再び醜い争いを続ける。 ついに海神の怒りにふれ、男達は海中に没する。 静かに泳ぎたる鯨の背に娘は一人眠り続ける。" ;
    schema:disambiguatingDescription "影絵" ;
    schema:identifier "NAE0083" ;
    schema:name "鯨" ;
    schema:pagination "196" ;
    schema:productionCompany "大藤信郎プロダクション" ;
    schema:releaseDate "1927年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0083> ;
    schema:volumeNumber "1" .

