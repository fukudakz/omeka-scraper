    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ふしぎなくすり" ;
    schema:about "岡本忠成が株式会社エコーを設立。電通映画社と共同製作の形での第一作。星新一のSFショー ト・ショートの人形映画化。" ;
    schema:audio "トーキー" ;
    schema:author "星新一" ;
    schema:awards "第二十回毎日映画コ ンクール大藤賞", "第十六回東京都教育映画コンクール銀賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15352>, <https://www.nihon-animation-eigashi.com/work-db/item/15795> ;
    schema:color "カラー" ;
    schema:composer "音楽：真鍋理一郎" ;
    schema:contentType "16mm" ;
    schema:contributor "人形アニメーション：岡本忠成、園哲太郎、マガリ文子", "人形：田畑精一、保坂純子", "撮影：吉岡謙", "演出：岡本忠成", "照明：野村隆三", "編集：永江恒夫", "脚本：村治夫", "装置：三五了、斎藤美喜雄、斎藤堅", "製作：村治夫", "進行：安部文彦" ;
    schema:correction "製作を更新 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "世界的な科学者エフ博士が不思議な薬を発明したニュースを聞いた怪盗ドロンと部下のトンキーが早速盗みに入る。博士の助手ボン少年、九官鳥のネム公が賊と戦うが結局盗まれる。だが、この薬は良心を呼び戻す薬で、試飲させられた部下のトンキーは正直な人間になり、親分を置き去りにして博士にお詫びに来るというオチ。" ;
    schema:duration "14分" ;
    schema:identifier "NAE0738" ;
    schema:isBasedOn "「盗んだ書類」（朝日新聞日曜版『みんなの童話』連載）" ;
    schema:materialExtent "156m" ;
    schema:name "ふしぎなくすり" ;
    schema:pagination "277" ;
    schema:productionCompany "電通映画社、株式会社エコー" ;
    schema:releaseDate "1965年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0738> ;
    schema:volumeNumber "1" .

