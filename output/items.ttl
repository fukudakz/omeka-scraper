    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "あめや狸" ;
    schema:about "【R6追加】\nSP盤ビクターレコード50715のA面とB面に対応するレコード・トーキー。A面のタイトルは「漫画 あめやたぬき」でB面が「漫画トーキー あめや狸」。「童謡唱歌 あめや狸」は作詞作曲が佐々紅華、独唱が二村定一、台詞が平井英子（お嬢さん役）、演奏が日本ビクター管弦楽団。" ;
    schema:alternateName "漫画 あめやたぬき", "漫画トーキー あめや狸" ;
    schema:audio "レコード・トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/19429>, <https://www.nihon-animation-eigashi.com/work-db/item/21816>, <https://www.nihon-animation-eigashi.com/work-db/item/32462> ;
    schema:color "白黒" ;
    schema:contentType "16mm" ;
    schema:contributor "宮下万蔵" ;
    schema:correction "別タイトル、製作、作者・スタッフ、音声、略筋、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "【R6追加】\nあめやのおじさんがお嬢さんにあめを売り、ダルマさんや福助の踊りを見せる。最後に狸踊りをすると、子狸に化けたお嬢さんにあめを全部盗まれてしまう。" ;
    schema:duration "6分" ;
    schema:identifier "NAE0197" ;
    schema:materialExtent "61m" ;
    schema:name "あめや狸" ;
    schema:pagination "205" ;
    schema:productionCompany "十字屋小型映画部（マーヴェルグラフ）" ;
    schema:releaseDate "1931年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0197> ;
    schema:volumeNumber "1" .

