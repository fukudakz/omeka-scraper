    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "木村角山" ;
    schema:description "雷のゴロ吉シリーズ第二編。虎の皮のパンツ一枚で雲の峰のハイキング。時局柄天上にも爆撃機が現われ、ゴロ吉の領分を荒すので腹を立てたゴロ吉、爆撃機を追いかけ下界へ降りる。ここで各種の新型飛行機と飛行競技。地上にとび下りたゴロ吉、今度は戦車と仲よしになり、可愛らしい娘を助けたりする。" ;
    schema:distribution "深田商会映画部" ;
    schema:duration "10分" ;
    schema:identifier "NAE0331" ;
    schema:materialExtent "275m" ;
    schema:name "低空五十米" ;
    schema:pagination "221" ;
    schema:productionCompany "京都童画の会" ;
    schema:releaseDate "1937年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0331> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/718>
    rdf:type o:Item, schema:CreativeWork ;
