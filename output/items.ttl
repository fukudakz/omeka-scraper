    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "月夜とめがね" ;
    schema:about "小川未明の童話をマルティプレーン撮影と光学的処理で作られた切り紙による幻想的な動画。" ;
    schema:author "小川未明" ;
    schema:awards "第三回「アニメーション・フェスティバル」公募部門奨励賞", "第二十一回毎日映画コンクール教育文化映画賞" ;
    schema:color "カラー" ;
    schema:composer "音楽：一柳慧" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：島村達雄、学研動画スタッフ", "撮影：山本明生", "演出：島村達雄", "製作担当：神保まつえ", "製作：原正次" ;
    schema:dateCreated "1966年9月" ;
    schema:description "森の木々や野原の草花がうす青く輝いて見える美しい月夜。ある家の中で、老婆が一人、針仕事。目がかすんだ老婆は針に糸がよく通らない。夜更け、誰かが戸をたたく。男の子が立っていて「目鏡を買って下さい」と沢山並べる。目鏡をかけると、はっきり見えるので大喜びで買う。次にやって来たのは可愛いい女の子で、涙を一杯ため、指にケガをしたと言う。老婆は傷の手当をと目鏡をかけると、女の子ではなく、きれいな一羽の蝶がいた。驚いて目鏡を外すと誰もいなくて、あたりは月の光が輝き、遠くの花畑の上を蝶が飛んでいた。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0774" ;
    schema:isBasedOn "『月夜とめがね』より" ;
    schema:name "月夜とめがね" ;
    schema:pagination "282" ;
    schema:producer "神林伸一" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0774> ;
    schema:volumeNumber "1" .

