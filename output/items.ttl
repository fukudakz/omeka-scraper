<https://www.nihon-animation-eigashi.com/work-db/api/items/1273>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ふしぎなごいし" ;
    schema:actors "解説：左幸子" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽：御法川清一" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：高知一彦", "撮影：水戸芳人", "演出：鎌倉伴作", "製作：桑名理夫", "録音：鳥羽和一" ;
    schema:dateCreated "1958年9月" ;
    schema:description "仲良しのシンちゃんとタンちゃんが山にトンボ取り。碁をうつ不思議な二人の老人に出会う。老人達は白と黒の碁石を二人にくれる。白の碁石は投げると物が増え、黒い碁石は物が消える。近道を帰ると大きな岩で道がふさがっている。タンちゃんが黒い碁石を投げると岩が消えた。物陰から見ていた山賊達がそれを寄こせと追いかける。谷にかかった橋はこわれているが白い碁石を投げると橋はのびて二人は渡ることが出来た。山賊が渡りかけた時、黒い碁石を投げたので橋は消え山賊達は谷底へ落ちる。二人は我家に帰り、家の米俵白い碁石を投げて沢山増やしお土産にする。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0591" ;
    schema:materialExtent "247m" ;
    schema:name "ふしぎなごいし" ;
    schema:pagination "254" ;
    schema:productionCompany "近代テレビ映画社" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0591> ;
    schema:volumeNumber "1" .

