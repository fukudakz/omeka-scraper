<https://www.nihon-animation-eigashi.com/work-db/api/items/1353>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ゼロの発見" ;
    schema:about "昭和十四年に初版が出て以来、岩波新書のベスト・セラーの一冊として読まれて来た吉田洋一著「零の発見」をもとに、著者自身が監修を行い、久里洋二が動画を担当した。数字の歴史を動画化したユニークな作品。スポンサーが銀行と言うのも数字に縁のある関係で面白い。" ;
    schema:actors "河合坊茶、ほか" ;
    schema:audio "トーキー" ;
    schema:author "吉田洋一" ;
    schema:awards "第二回日本産業映画コンクール奨励賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/18109> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：松村禎三" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：久里実験漫画工房 久里洋二、一乗清明、乃村知子、足立登美枝、宇野涼子", "撮影：三乗明", "監修：吉田洋一立教大教授", "監督：富沢幸男、杉原せつ", "脚本：大沼鉄郎", "製作：小倉友助" ;
    schema:correction "原作、原作者を追加 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:dateCreated "1963年6月19日" ;
    schema:description "古代人類は十本の手の指と、十本の足の指を使い二十まで数える二十進法を見つけた。工ジプト時代には記号の数字で数を数える様になったが十万以上のケタになるとお手あげ。インドでは既に一から九までの数字が出来ていたが、哲学者がついに0（ゼロ）を発見し、現代数字の基礎が出来、数字の組合せから複雑な現代の電算機が誕生する。" ;
    schema:duration "21分" ;
    schema:identifier "NAE0671" ;
    schema:isBasedOn "『零の発見』（初版1939年）" ;
    schema:materialExtent "580m" ;
    schema:name "ゼロの発見" ;
    schema:pagination "268" ;
    schema:producer "埼玉銀行" ;
    schema:productionCompany "アジア映画社" ;
    schema:releaseDate "1963年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0671> ;
    schema:volumeNumber "2" .

