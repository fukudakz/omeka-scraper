    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "蛸の骨" ;
    schema:about "【R6追加】\n横浜シネマ商会の短篇文化映画シリーズ「アテナライブラリー Atena Library」第25篇。35mm版の発売は関東方面を岡本洋行が、関西方面を奥商会が行い、16mm版は小西六本店が行った。" ;
    schema:audio "サイレント" ;
    schema:awards "文部省推薦" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/30791-11>, <https://www.nihon-animation-eigashi.com/work-db/item/31214>, <https://www.nihon-animation-eigashi.com/work-db/item/31953>, <https://www.nihon-animation-eigashi.com/work-db/item/T0001> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司", "原案・脚色：青地忠三", "撮影：上野行清" ;
    schema:correction "委託、配給、フォーマット、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "竜宮城の乙姫様の病気をなおすためには猿の生きギモが必要で、家来の蛸に使者の白羽の矢が立つ。蛸は目的地で猿をつかまえ、亀の背に乗せ、竜宮めざすが、うっかり目的を話す。猿は猿智恵でうまく逃げる。失敗のお詫びに蛸は自分の骨を抜き取って去って行く。それ以来、蛸には骨がなくなったという物語。" ;
    schema:distribution "提供：横浜シネマ商会", "配給 [関東]：岡本洋行", "配給 [関西]：奥商会" ;
    schema:duration "20分" ;
    schema:identifier "NAE0085" ;
    schema:materialExtent "367m" ;
    schema:name "蛸の骨" ;
    schema:pagination "196" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1927年11月（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0085> ;
    schema:volumeNumber "1" .

