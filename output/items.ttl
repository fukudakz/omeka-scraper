    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "天の岩戸開き" ;
    schema:actors "劇団不二" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "作曲：平井康三郎" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出・撮影：大藤信郎", "構成：小野祖教（国学院大教授、文博）", "背景：中島喜美" ;
    schema:dateCreated "1955年6月" ;
    schema:description "影絵による古事記の神話。イザナギ、イザナミの神が現われ、ホコで海をかき回し、オノコロから本州までの大八州（オオヤシマ）を造る。 アマテラス、ヨミ、スサノオの三人の神も生まれる。三神の治める国が決められるが、海原の国治めが不平のスサノオはタカマガハラで乱暴を働き、そのため姉のアマテラスは岩戸に隠れてしまう。神々の合唱やウズメの踊りなどでアマテラスはやっと岩戸を開く。改心したスサノオはアマテラスに励まされ次の任地へ旅立つ。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0546" ;
    schema:materialExtent "305m" ;
    schema:name "天の岩戸開き" ;
    schema:pagination "246" ;
    schema:producer "神社本庁" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1955年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0546> ;
    schema:volumeNumber "1" .

