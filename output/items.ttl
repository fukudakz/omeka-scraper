    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "空飛ぶゆうれい船" ;
    schema:about "石森章太郎が三十二年から三十三年にかけて『少年』に連載したSF調の海洋冒険漫画の“幽霊船”を題材にした中編のB級動画。B級の割にていねいな作画で池田宏演出はテンポも早く佳作。空飛ぶ艦船のアイデアは後年、松本零士の傑作TV動画「宇宙戦艦ヤマト」でも生かされる。" ;
    schema:actors "[滝隼人] 野沢雅子、[黒汐会長] 田中明夫、[黒汐夫人] 里見京子、[ルリ子] 岡田由紀子、[嵐山] 名古屋章、[幽霊船船長] 納谷悟郎、[埴輪長官] 里見京子" ;
    schema:audio "トーキー" ;
    schema:author "石森章太郎" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/13779>, <https://www.nihon-animation-eigashi.com/work-db/item/18567> ;
    schema:color "フジカラー" ;
    schema:composer "主題歌作詞：辻真先", "作曲：小野崎孝輔", "歌：泉谷広、ハニー・ナイツ", "音楽：小野崎孝輔" ;
    schema:contentType "35mm" ;
    schema:contributor "ゼログラフィ：松本寿夫", "トレース：奥西紀美代、植木知子", "仕上検査：小椋正豊、西元敦子", "作画監督：小田部羊一", "動画：堰合昇、相磯嘉雄、吉田茂承、松原明徳、坂野隆雄、薄田嘉信、笠井清子、坂野勝子、斎藤瑛子、長谷川玲子、黒沢隆夫、篠原征子、池原昭治、的場茂夫、正井融、村松錦三郎、角田紘一、服部照夫、石山毬緒、佐々木章、長沼寿美子、山田みよ", "原画：奥山玲子、菊池貞雄、金山通弘、大田朱実、森英樹、宮崎駿、阿部隆", "彩色：中林伸子、小島博美", "撮影：片山幸男、武田寬", "演出助手：奥西武、佐々木勝利", "演出：池田宏", "特殊効果：林富喜江", "現像：東映化学工業株式会社", "編集：古村均", "美術：土田勇", "背景：伊藤英治、池田秀雄、城戸求", "脚本：辻真先、池田宏", "色彩設計：秦秀信", "製作進行：古沢義治、岸本松司", "製作：大川博", "記録：的場節代", "調色：中込綾彦", "録音：波多野勲", "音響効果：大平紀義" ;
    schema:dateCreated "1969年7月" ;
    schema:description "ぼろぼろの古めかしい帆船が空を飛び事件を起こす。この謎の帆船にドクロの船長が乗っていて幽霊船と恐れられている。主人公の竜隼人少年は幽霊船の使者と称して都市を破壊する巨人ロボット、ゴーレムに両親を殺され、復讐の機会を狙う。だが、真の悪者は世界征服を狙う海底魔王ボアーが黒幕だと判る。幽霊船は実は正義の味方で、原子力エネルギー、反重力装置を持ち、海中から空中まで飛べる万能船だった。この船に乗って幽霊船長と協力し、敵の本拠の海底基地を攻撃し、地球には再び平和が戻り、船長は死んだと思った父だった。" ;
    schema:disambiguatingDescription "東映スコープ" ;
    schema:duration "1時間" ;
    schema:identifier "NAE0866" ;
    schema:isBasedOn "コダマプレス刊『幽霊船』" ;
    schema:materialExtent "1658m" ;
    schema:name "空飛ぶゆうれい船" ;
    schema:pagination "299" ;
    schema:producer "関政次郎、茂呂清一、旗野義文" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1969年7月20日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0866> ;
    schema:volumeNumber "6" ;
    schema:workPresented "東映系" .

