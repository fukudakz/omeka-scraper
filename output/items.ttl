    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マリン・スノー" ;
    schema:about "精緻なイラストで知られる真鍋博が“舞台のためのアニメーション”というタイトルで構成したもの。NHKで放送された木島始の放送詩 「マリン・スノー」をサウンド・トラックにし、観世栄夫の能の動きをパントマイムで表現。照明（今井直次）の変化を組合せた実験的な舞台ショーにした。作品自体は各種のスクリーン・トーンの上に海の生物を切り抜いて置き、カメラのトラック・アップ、バックなどの操作によって動きを創り出したもの。“アニメーション三人の会”第一回発表会（11月26日東京・草月ホール）で公開。" ;
    schema:color "白黒" ;
    schema:composer "音楽：林光" ;
    schema:contentType "16mm" ;
    schema:contributor "演出：真鍋博", "脚本：木島始" ;
    schema:identifier "NAE0633" ;
    schema:name "マリン・スノー" ;
    schema:pagination "261" ;
    schema:productionCompany "真鍋博" ;
    schema:releaseDate "1960年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0633> ;
    schema:volumeNumber "1" .

