<https://www.nihon-animation-eigashi.com/work-db/api/items/1506>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "海ひこ山ひこ" ;
    schema:actors "清水マリ、大山のぶ子、増山江威子、田上和枝、家弓家正" ;
    schema:audio "トーキー" ;
    schema:awards "第二十一回東京都教育映画コンクール銀賞", "第十五回教育映画祭最高作品賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/10717>, <https://www.nihon-animation-eigashi.com/work-db/item/20302>, <https://www.nihon-animation-eigashi.com/work-db/item/80113> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：三善晃" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーション：和田京子、見米豊、尾崎良、関口正子", "人形：佐々木章", "撮影：平井寛、阿部行雄", "演出：渡辺和彦", "現像：東洋現像所", "美術：上田悌三、中村貞雄", "製作担当・脚本：神保まつえ", "製作：原正次", "録音：アオイスタジオ" ;
    schema:description "兄の海彦は乱暴者だが釣の名人。弟の山彦は、やさしく皆から好かれる弓矢の名人。ある日、二人は仕事を交替し海彦は山へ猟へ。山彦は海へ釣りに行き、海彦の大事な釣針をなくす。海彦にしかられ、思案していると不思議な老人が海底の美しい宮殿に連れて行く。そこで海の神と娘の豊玉姫の歓待を受ける。魚がのみ込んだ釣針も返してもらう。竜宮シーンの撮影は、実際に海底の実写を撮り、参考にしたそうだ。" ;
    schema:distribution "提供：日本勧業銀行" ;
    schema:duration "18分" ;
    schema:identifier "NAE0824" ;
    schema:materialExtent "498m" ;
    schema:name "海ひこ山ひこ" ;
    schema:pagination "293" ;
    schema:producer "日本勧業銀行、石川茂樹" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1968年8月1日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0824> ;
    schema:volumeNumber "2" ;
    schema:workPresented "東宝系" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1507>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "みにくいあひるの子" ;
    schema:about "この映画で注目されるのはセットにプラスチックなどの素材を用いて幾何学的な抽象模様を作り出したことだ。白鳥などの動物キャラクターはリアルに可愛く作られていて対照的だった。アヒルの動きを研究するため、ヒナのうちから飼育観察、撮影終了時には成鳥になり、スタッフにすっかりなついたという。また空中を飛ぶシーンは鳥のキャラクターを釣糸でつるし齣撮りする面倒な撮影がされたが“吊リメーション”なる新語（?）も生まれたそうだ。" ;
    schema:actors "中村メイ子" ;
    schema:audio "トーキー" ;
    schema:awards "四十三年度児童福祉文化賞奨励賞", "四十三年度青少年映画賞", "文部省特選", "第二十一回東京都教育映画コンクール銀賞", "第二十三回毎日映画コンクール大藤賞", "第二十二回日本映画技術賞（撮影：平井寛）", "第十七回キネマ旬報文化映画ベスト・テン十位" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15143>, <https://www.nihon-animation-eigashi.com/work-db/item/20290> ;
    schema:color "カラー" ;
    schema:composer "音楽：斎藤高順" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーター：和田京子、見米豊、尾崎良", "人形：佐々木章", "効果・録音：アオイスタジオ", "撮影：平井寛、阿部行雄", "現像：東洋現像所", "美術：上田悌三、中村貞雄", "脚本・演出：渡辺和彦", "製作担当：神保まつえ", "製作：原正次、石川茂樹" ;
    schema:description "醜いアヒルの子が美しい白鳥に成長する。" ;
    schema:distribution "提供：日本勧業銀行" ;
    schema:duration "20分" ;
    schema:identifier "NAE0825" ;
    schema:name "みにくいあひるの子" ;
    schema:pagination "293" ;
    schema:producer "日本勧業銀行" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1970年8月1日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0825> ;
    schema:volumeNumber "2" ;
    schema:workPresented "東宝系" .

