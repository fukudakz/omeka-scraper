    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "人魚" ;
    schema:about "草月のアニメーション・フェスティバル出品用の作品。シンプルな線で表現されたファンタジー動画。" ;
    schema:color "カラー" ;
    schema:composer "音楽：冨田勲（ドビュッシー 「牧神の午後への前奏曲」より）" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：沼本清美", "原画：山本繁", "撮影：佐倉紀行", "演出：虫プロ演出部", "製作：手塚治虫" ;
    schema:dateCreated "1964年9月" ;
    schema:description "空想好きの少年の話で、少年はある日、浜辺で人魚を見つけ、恋をしてしまう。実際は水槽の金魚なのだが...。ところがほかの人にはただの魚にしか見えない。周囲から狂人にされるが、人魚への思慕はつのるばかりで、ついに少年は精神鑑定を受け、都会へ移される。何年か後に家へ帰ってみると、人魚はただの魚になっていた。少年は浜辺で泣いた。少年が死ぬ時、かすかに人魚が見えたのだ...。" ;
    schema:duration "4分" ;
    schema:identifier "NAE0702" ;
    schema:name "人魚" ;
    schema:pagination "273" ;
    schema:productionCompany "虫プロダクション" ;
    schema:releaseDate "1964年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0702> ;
    schema:volumeNumber "1" .

