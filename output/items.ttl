    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "白鼠物語" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/22165> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "不詳" ;
    schema:description "いたずら好きの白鼡は台所を荒すが猫が来たので困ってしまい、大黒様にお願いし、猫に姿を変えてもらう。犬におどされたので今度は犬の姿に。犬になると虎にいじめられたので、虎に姿を変えてもらい羊をいじめていると、人間が総出で虎を捕える。困っていると、大黒様が現われ、爪は爪だけの力しかないのだからおとなしくせよとさとされ、元の白鼡の姿にかえす。それからはおとなしくなって大黒様のもとで暮らすようになった。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0321" ;
    schema:materialExtent "250m" ;
    schema:name "白鼠物語" ;
    schema:pagination "220" ;
    schema:productionCompany "奥商会映画部" ;
    schema:releaseDate "1937年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0321> ;
    schema:volumeNumber "1" .

