    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "兎と亀" ;
    schema:about "【R6追加】\n大正12年9月の関東大震災で北山映画製作所オーナーの北山清太郎の家屋や制作スタジオが損壊。北山は一家で関西へ。残された山本は北山映画製作所を引き継ぐが、制作スタジオがどこかは不詳。ナカジマ活動寫眞部は神戸なので、山本が神戸へ来て制作したことも考えられる。" ;
    schema:alternateName "教育お伽漫画　兎と亀" ;
    schema:audio "サイレント" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16740>, <https://www.nihon-animation-eigashi.com/work-db/item/21681>, <https://www.nihon-animation-eigashi.com/work-db/item/50144> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "山本早苗" ;
    schema:correction "別タイトル、製作、音声、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "唱歌「兎と亀」の忠実な動画化。" ;
    schema:identifier "NAE0037" ;
    schema:name "兎と亀" ;
    schema:pagination "193" ;
    schema:productionCompany "ナカジマ活動寫眞部", "北山映画製作所" ;
    schema:releaseDate "1924年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0037> ;
    schema:volumeNumber "1" .

