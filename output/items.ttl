    o:title "こねこのスタジオ" ;
    schema:actors "中村メイコ" ;
    schema:audio "トーキー" ;
    schema:awards "第六回教育映画祭特別賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15040>, <https://www.nihon-animation-eigashi.com/work-db/item/21304>, <https://www.nihon-animation-eigashi.com/work-db/item/25282>, <https://www.nihon-animation-eigashi.com/work-db/item/90231> ;
    schema:color "カラー" ;
    schema:composer "音楽：山田栄一" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：紺野修司、坂本雄作、喜多まさむ", "原画・演出：森やすじ", "撮影：石川光明", "背景：草野和郎", "進行：稲田伸生", "録音：森武" ;
    schema:dateCreated "1959年4月9日" ;
    schema:description "猫の映画監督はノッポとチビの鼡を使い撮影開始。ところがこのコンビ、NGばかり出すので怒って二匹はクビ。ロボットの俳優を作り、スタジオをオートメ化し、リモコンでロボットに演技をさす。クビになった鼡達がからんでロボットとけんか。スタジオは目茶目茶。背景セットに東映城らしきものが出て来るのが面白い。" ;
    schema:duration "16分" ;
    schema:identifier "NAE0615" ;
    schema:materialExtent "432m" ;
    schema:name "こねこのスタジオ" ;
    schema:pagination "258" ;
    schema:producer "山本早苗" ;
    schema:productionCompany "東映動画" ;
    schema:releaseDate "1959年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0615> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1298>
