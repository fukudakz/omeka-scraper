    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "敵機来らば" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16582-14>, <https://www.nihon-animation-eigashi.com/work-db/item/19363-41> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "演出・撮影：山本早苗" ;
    schema:description "蛙の国（日本）を兎の国（アメリカ）が爆撃しに来る。蛙の国はSF的な新兵器を多数出動させ、小鳥達の協力で空に海に陸に兎軍を打ち破る。蛙、小鳥の世界を借りて防空の必要を解説する。「スパイ撃滅」と同じカットがかなり含まれている。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0401" ;
    schema:materialExtent "306m" ;
    schema:name "敵機来らば" ;
    schema:pagination "228" ;
    schema:productionCompany "三幸商会" ;
    schema:releaseDate "1942年6月11日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0401> ;
    schema:volumeNumber "1" ;
    schema:workPresented "浅草 江川劇場" .

