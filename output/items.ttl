<https://www.nihon-animation-eigashi.com/work-db/api/items/1264>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "注文の多い料理店" ;
    schema:about "学校向けの教材映画を作っていた学研映画部が、最初の人形映画を製作。宮沢賢治の原作で、スリラー・コメディーの作品。" ;
    schema:audio "トーキー" ;
    schema:author "宮沢賢治" ;
    schema:color "白黒" ;
    schema:composer "音楽：林光" ;
    schema:contentType "35mm" ;
    schema:contributor "人形：高山良策", "撮影：平井寛", "演出：小野豪", "脚本：神林伸一" ;
    schema:dateCreated "1958年11月" ;
    schema:description "デブの男と青年が森に狩に行く。鳥一羽とれず、猟犬も姿を消す。空腹の二人の目に入ったのは不思議な館。看板に注文の多い料理店とあるので入る。長い廊下の奥にドアがあり、その向うは又もや廊下。そのたびに銃を置け、靴を脱げ、などの指示が書いてある。やっと食堂に到着したが皿もフォークもない。そこで二人は気付く。注文の多いのは、この家の主人がお客に出す注文のことで、我々は料理されるのだと。ドアは閉って開かず、鍵穴から山猫のギョロギョロ光った目が見える...。最後にどうにか助かって逃げ帰る。" ;
    schema:duration "18分" ;
    schema:identifier "NAE0582" ;
    schema:materialExtent "484m" ;
    schema:name "注文の多い料理店" ;
    schema:pagination "253" ;
    schema:producer "原正次" ;
    schema:productionCompany "学研映画部" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0582> ;
    schema:volumeNumber "2" .

