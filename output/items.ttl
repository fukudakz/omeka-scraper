    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "泳げ泳げ動物の水泳大会" ;
    schema:alternateName "泳げやつはもの", "泳げや泳げ" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/31223>, <https://www.nihon-animation-eigashi.com/work-db/item/31958>, <https://www.nihon-animation-eigashi.com/work-db/item/32572> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "不詳" ;
    schema:description "動物の水泳大会で見えっぱりの猿君は泳げないとはいえず、選手として出場しプールに飛び込むが、沈んでしまう。プールの底には海底のように海藻が生え、サンゴがあり、カッパが住んでいる。猿君はカッパと斗い、頭の皿を取り上げ、皿を返すかわりに背中に乗せて泳いでいるように見せてもらい見事に一着となる。" ;
    schema:identifier "NAE0361" ;
    schema:name "泳げ泳げ動物の水泳大会" ;
    schema:pagination "223" ;
    schema:productionCompany "不詳" ;
    schema:releaseDate "1939年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0361> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/748>
