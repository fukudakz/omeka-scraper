    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "どうぶつむらのこどもたち" ;
    schema:about "富士銀行が創立85周年記念に同年四月から実施した「子供を交通事故から守る」交通安全キャンペーンの一つとして学研に委託製作した人形映画。" ;
    schema:color "カラー" ;
    schema:composer "音楽：いずみたく" ;
    schema:contentType "35mm" ;
    schema:contributor "アニメーション：内藤揚子、安藤映子、秋山純子", "人形製作：佐々木章", "撮影：佐竹荘一、平井寛", "演出：神保まつえ", "美術：酒向満", "脚本：滝沢林三", "製作：原正次" ;
    schema:description "森の動物村に山羊の村長が大ニュースを持って来た。動物村に自動車道路が出来るのだ。動物達は大喜びするが、やがて交通戦争に巻きこまれる。交通規則を作り、熊さんが交通巡査となって指導に当たる。" ;
    schema:duration "21分" ;
    schema:identifier "NAE0737" ;
    schema:name "どうぶつむらのこどもたち" ;
    schema:pagination "277" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1965年" ;
    schema:sourceOrganization "富士銀行" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0737> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1420>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
