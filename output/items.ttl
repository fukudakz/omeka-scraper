    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "国歌・君が代" ;
    schema:about "コロンビアレコードA18にシンクロする。 第一節・大八州国創生、第二節・君が代歌詩、第三節・天岩窟、第四節・金色のとび、の四節より成る。上映会では必ず開会に上映する映画。" ;
    schema:audio "レコード・トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "大藤信郎" ;
    schema:description "レコード演奏に合せ「君が代」の文字が現われ、菊型のアイリスが開きイザナミ、イザナギの神が現われ大八州国（日本）を創られる。レコードは男性合唱で「君が代」の字幕が消え、天岩戸となる。諸々の神々が集って神楽を舞い、手力男命が天照大神のお隠れになった岩戸を押し開く。雲型のアイリスが開くと、金色のトビが弓の上にとまる。このトビから放つ光は八咫の鏡となる。" ;
    schema:disambiguatingDescription "影絵" ;
    schema:identifier "NAE0186" ;
    schema:name "国歌・君が代" ;
    schema:pagination "204" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1931年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0186> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/573>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
