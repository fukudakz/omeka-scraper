    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "玉手箱" ;
    schema:alternateName "ちんころ平平玉手箱" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/30789> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：大藤信郎" ;
    schema:description "ある春の日、昼寝の夢を、亀に破られた\"ちんころ平々\"かんかんに怒って逃げる亀を竜宮城まで追いかける。竜宮では玉手箱の虫干し中。 箱の中から沢山の小ガニが現われ紙を切り抜き魚を作っていた。面白そうなので城内へ入ろうとすると、門番に陸の者は入れられないと阻止される。どうにかして入りたいと、一匹の魚の皮をはぎ取り、魚に化けて竜宮城へ入り玉手箱を盗み出し魚の追跡をふり切って逃げ帰る。玉手箱を開けてみると出て来たのはタコ入道で散々な目にあい玉手箱も奪い返される。" ;
    schema:duration "8分" ;
    schema:identifier "NAE0302" ;
    schema:materialExtent "233m" ;
    schema:name "玉手箱" ;
    schema:pagination "217" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0302> ;
    schema:volumeNumber "1" .

