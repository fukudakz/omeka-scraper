<https://www.nihon-animation-eigashi.com/work-db/api/items/1281>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "こうもり" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/31005> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "編曲・指揮：吉沢博" ;
    schema:contentType "35mm" ;
    schema:contributor "作画監督：上野武夫", "動画：東喜三郎、井山忠行、田中和男、鶴岡弘英、押田守人、宮島英作、高松次郎、石山ユミ、清水孝", "背景：荒木寒山、田村宗太郎", "脚色：中井金兵衛", "色彩指導：難波田竜起" ;
    schema:dateCreated "1958年7月" ;
    schema:description "こうもりの子供が森へ遊びに行くが動物たちは誰も相手にしてくれない。泣きながら洞穴の家に帰りおじいさんに話すと、訳を話してくれた。昔、日照りが続き、森の動物や鳥たちは水に困り、川上にダムを作って飲み水をたくわえることにした。獣達は重い石を運び、鳥達は木の枝を運んだ。しかしこうもり達は昼寝ばかりした。リスがやって来て仕事を手伝えと言うと、こうもりは羽があるから鳥と一緒に仕事をやっているとだます。ハトが手伝えというと獣の仲間と仕事をしているとだます。ダムが完成し、お祝に獣と鳥の間で野球試合が開かれたが、獣軍が優勢な時は獣軍の応援を、鳥軍が勝ちそうになると鳥軍チームへ応援に行った。そこへ怪物が出現したが、鳥や獣は一致団結して立ち向った。こうもりはいち早く洞穴に逃げこんだ。怪物は恐れをなして逃げ、皆は団結の力で勝ったと大祝賀会を開いた。この様子を見たこうもりは洞穴から出て皆と一緒に踊り始めたが、兎が、一体こうもりは我々に協力したことがあるのかと言い出すと、皆はずるい奴だと非難した。こうもりは一匹ずつこそこそ洞穴へ逃げ帰り、それ以来、皆から嫌われ暗い洞穴で生活しなければならなくなったのだと、おじいさんの昔話は終わった。イソップの動画化。" ;
    schema:distribution "配給：NCC" ;
    schema:duration "10分" ;
    schema:identifier "NAE0599" ;
    schema:materialExtent "275m" ;
    schema:name "こうもり" ;
    schema:pagination "254" ;
    schema:productionCompany "中井プロダクション" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0599> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1282>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ペンギンぼうやルルとキキ" ;
    schema:about "【R7追加】\nこの作品から川本喜八郎は離れる。人形制作は飯沢匡の仕事で川本などと一緒だった熊谷達子（みちこ=谷内六郎夫人）。", "三十一年十一月、戦後日本初の南極観測船“宗谷”が出航。翌年一月、南極予備観測隊は昭和基地を設営した。このニュースをもとに隊員とペンギン親子の愛情交換を人形映画にした心温まる佳作。子供ペンギンが特に可愛いい。" ;
    schema:audio "トーキー" ;
    schema:awards "第五回教育映画祭動画部門特別賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15041> ;
    schema:color "白黒" ;
    schema:composer "音楽：林光" ;
    schema:contentType "35mm" ;
    schema:contributor "撮影：岸次郎", "演出：持永只仁", "脚本：村治夫、中江隆介", "製作：稲村喜一" ;
    schema:correction "解説（補足）を追加 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:dateCreated "1958年9月" ;
    schema:description "生れたばかりのペンギンの子、ルルは冒険ずき。迷子になり南極観測隊員に救われる。ルルは両親とやっと再会。ルルは別れを惜しむ隊員から記念にネッカチーフをもらって帰る。" ;
    schema:duration "17分" ;
    schema:identifier "NAE0600" ;
    schema:materialExtent "461mm" ;
    schema:name "ペンギンぼうやルルとキキ" ;
    schema:pagination "255" ;
    schema:productionCompany "電通映画社、人形映画製作所" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0600> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1283>
    rdf:type o:Item, schema:CreativeWork ;
