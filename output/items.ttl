    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "赤い井戸" ;
    schema:actors "解説：フランキー堺" ;
    schema:audio "トーキー" ;
    schema:author "宮下正美" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17054> ;
    schema:color "カラー" ;
    schema:composer "音楽：団伊玖磨" ;
    schema:contentType "16mm" ;
    schema:contributor "人形アニメーション：太田サトル", "撮影・演出：仲沢簾治", "編集：伊勢長之助", "脚本：森園忠", "造型：武田謙之助" ;
    schema:dateCreated "1960年7月" ;
    schema:description "日照り続きの村に旅のお坊さんが来て水を欲しいと頼むが一軒の家では追払われる。次の家は親切で井戸から水を汲んで飲ませる。坊さんは大変喜び「この水は絶対枯れない。しかし、水が赤くなったら村に変事が起こる」と予言して去る。村人は土下座して送る。これを聞いた山賊達は井戸の水を赤く染めて村人達が逃げたスキに家財を盗もうとする。突然集中豪雨で山賊達はおぼれ、村には平和が戻る。民話の人形映画化。" ;
    schema:duration "12分" ;
    schema:identifier "NAE0624" ;
    schema:materialExtent "137m" ;
    schema:name "赤い井戸" ;
    schema:pagination "260" ;
    schema:productionCompany "十六ミリ映画株式会社" ;
    schema:releaseDate "1960年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0624> ;
    schema:volumeNumber "1" .

