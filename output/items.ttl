    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "狼少年ケン" ;
    schema:about "手塚治虫の虫プロ製作“鉄腕アトム”のTVシリーズは初のTV動画として大成功だった。東映動画でもNET・TVと提携しTV用シリーズの動画第一作“狼少年ケン”を製作。内容はキプリングの“ジャングル・ブック”に題材を得て、ヒマラヤ地方の狼族に育てられた人間の子供ケンが狼の子供、チッチとポッポを仲間に冒険をする。キャラクター・デザイン、演出は才人月岡貞夫が担当した。トレースには新鋭のゼロックスが使用された。TV放映は三十八年十一月二十五日から NETをキー局に放映された。東映では“わんわん忠臣蔵”公開に際しテスト・ケースとしてTVシリーズの第二話、第三話を編集し劇場公開（東京地区のみ）したところ、好評だったので、以後、劇場用としてTV作品が堂々と上映される様になった。" ;
    schema:actors "[狼少年ケン] 西本雄司、[狼の子・チッチ] 青木勇嗣、[狼の子・ポッポ] 水垣洋子、[ボス] 八奈見乗児" ;
    schema:audio "トーキー" ;
    schema:author "大野寛夫" ;
    schema:color "白黒" ;
    schema:composer "演奏：アンサンブル・ピボ、ビクター児童合唱団", "音楽：小林亜星" ;
    schema:contentType "35mm" ;
    schema:contributor "仕上：佐藤章二", "動画：平田敏夫、上口照人、平川謹之介", "撮影：菅原英明", "演出・原画：月岡貞夫", "美術：児玉喬夫", "脚色：芹川有吾、大野寛夫", "録音：小西進" ;
    schema:duration "25分" ;
    schema:identifier "NAE0685" ;
    schema:materialExtent "685m" ;
    schema:name "狼少年ケン" ;
    schema:pagination "270" ;
