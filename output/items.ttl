<https://www.nihon-animation-eigashi.com/work-db/api/items/1248>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "子熊ちゃんの花束" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/20025>, <https://www.nihon-animation-eigashi.com/work-db/item/21660> ;
    schema:color "白黒" ;
    schema:composer "音楽：尾崎義雄" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：森川信英、庵原和夫", "彩画：小川清子", "背景：福村林平", "脚本・撮影・演出：芦田いわお", "録音：清島竹彦" ;
    schema:dateCreated "1957年3月" ;
    schema:description "山奥に三匹の子熊が病気で町の病院に入院している母熊の退院を待ちわびながら暮していた。ある日、三匹の子熊はお母さんを見舞に行くことを決める。長男熊は知恵も力もあるので、大きな魚をお土産に捕る。次兄は果物を取って来る。末っ子の女の子の熊は小さくて、お母さんの喜びそうなものを一生懸命探すが、力不足で失敗を重ねる。仕方なく野の花を摘んで持って行く。女の子は自分の見舞の品が一番粗末なので恥しがるが、お母さんはその花束を一番喜び、お土産より、三匹そろって仲よく見舞に来てくれることが一番嬉しいと言った。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0566" ;
    schema:materialExtent "253m" ;
    schema:name "子熊ちゃんの花束" ;
    schema:pagination "250" ;
    schema:productionCompany "芦田漫画製作所" ;
    schema:releaseDate "1957年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0566> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1249>
