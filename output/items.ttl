<https://www.nihon-animation-eigashi.com/work-db/api/items/692>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "おいらの非常時" ;
    schema:about "12年、東和商事が「無敵正義軍」と改題し再公開。キャラクターは「敵機来らば」と同じ。主人公は蛙で、耳が長く兎のような猫（？）が現われるのは、鳥獣戯画に発想をおいたからであろうか。SF的な新兵器が出現するのが面白い。" ;
    schema:alternateName "無敵正義軍" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：山本早苗" ;
    schema:description "池の付近に住む動物の国へ、ある日猫軍が飛行機で空襲。蛙軍の飛行機も応戦。水上では猫の海軍が攻撃をしかけて来るが、魚の海軍が撃退。夜になると猫軍は再び空襲するが兎の聴音機、ガチョウのサイレンが活躍。小動物はモグラの家へ避難。フクロウの目がサーチライトとなって敵機をやっつけるというのは池で寝ていた蛙の夢だった。" ;
    schema:duration "8分" ;
    schema:identifier "NAE0306" ;
    schema:materialExtent "226m" ;
    schema:name "おいらの非常時" ;
    schema:pagination "218" ;
    schema:productionCompany "日本電報通信社活動写真部" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0306> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/693>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "誠の報ひ" ;
    schema:about "18年3月18日浅草大東京封切の「城主と太郎」（解説・加藤柳美）は「誠の報ひ」の改題。" ;
    schema:alternateName "城主と太郎" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "片岡芳太郎" ;
    schema:description "働き者の百姓親子がいた。貧乏で農業に使う馬も飼えなかった。ある日、野良仕事の帰り道、花見帰りの酔客に難くせつけられている老人を助けた。老人はその国の城主で、お礼に沢山のお金をくれたが、辞退し一頭の馬をもらっただけだった。帰途、狼の大群に襲われたが馬の協力でけちらし無事に帰宅し、翌日から野良仕事にはげむ。" ;
    schema:distribution "岡本洋行" ;
    schema:duration "11分" ;
    schema:identifier "NAE0307" ;
    schema:materialExtent "305m" ;
    schema:name "誠の報ひ" ;
    schema:pagination "218" ;
    schema:productionCompany "山口シネマ" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0307> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/694>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "雷ゴロ吉下界修行" ;
    schema:audio "トーキー" ;
    schema:author "岸本吉蔵" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：正木統三", "監督：木村角山" ;
    schema:description "雷の子ゴロ吉が雲の上でタイコをたたいていると、一つが環から外れ下界へ落ちた。それ を追ったゴロ吉危うく雲から落ちそうになるが父雷が助ける。下界に落ちたタイコを取戻したくて泣くゴロ吉を見て可愛そうに思った両親は護身用の電磁石をヘソにつけて下界へ行かせた。雲に乗って地上へ降りたゴロ吉はペソ子と友達になり、彼女の家庭の盗難の危機を救い、タイコを取戻して再び天上へ帰る。" ;
    schema:distribution "東和商事映画部" ;
    schema:duration "8分" ;
    schema:identifier "NAE0308" ;
    schema:materialExtent "210m" ;
    schema:name "雷ゴロ吉下界修行" ;
    schema:pagination "218" ;
    schema:productionCompany "ヒトミ映画製作所" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0308> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/695>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "小鳥と兎" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "佐藤吟次郎", "千葉洋路" ;
    schema:description "平和な森の朝、兎一家は餅つき。子兎は遊びに夢中。餅を積んだ車をひいて坂道へ来た時、急に車は逆回転し池へはまる。兎は泳げず溺れかける。助けを呼ぶ声を聞いた小鳥は仲間を呼び一致団結で兎を助ける。ある日、野良猫に狙われた小鳥、しかし気づいていない。通り合せた兎がこれを見つけ、助けてもらったお礼返しと小鳥を助ける。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0309" ;
    schema:materialExtent "292m" ;
    schema:name "小鳥と兎" ;
    schema:pagination "218" ;
    schema:productionCompany "佐藤線映画製作所" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0309> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/696>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "皇国のために" ;
    schema:about "昭和3年木村白山「日の丸は輝く」のトーキー再版。昭和18年にも、編集・高波三郎、 撰曲・保瀬薫、モリモト映画社提供により再版されている。日露戦争二〇三高地の戦いをテーマにしたもの。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "佐藤吟次郎", "千葉洋路" ;
    schema:correction "別バージョンを関連付け [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "平和な村に住む凸山君。一方的な某国の国交断絶のため戦争が始まり、召集令状が農事にはげむ凸山君にもやって来た。喜び勇んで父母、村人に見送られて戦地に出発。戦地での凸山君の活躍はめざましく日本軍は敵陣地を陥落させた。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0310" ;
    schema:isRelatedTo <https://www.nihon-animation-eigashi.com/work-db/api/items/495> ;
    schema:materialExtent "283m" ;
    schema:name "皇国のために" ;
    schema:pagination "218" ;
    schema:productionCompany "佐藤線映画製作所" ;
    schema:releaseDate "1936年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0310> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/697>
    rdf:type o:Item, schema:CreativeWork ;
