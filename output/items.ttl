    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かみなりん子物語" ;
    schema:about "演出の高橋克雄は人形劇団プークに所属、演出をしていたが、人形映画に興味を持ち、東京・亀有の自宅隣りにスタジオを建て、脚本、演出、撮影を個人で担当するというスタートだった。「かみなりん子物語」は第一回作品である。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "16mm" ;
    schema:contributor "撮影：渡辺貞二郎", "脚本・演出：高橋克雄", "製作：池田永造" ;
    schema:dateCreated "1958年10月" ;
    schema:description "太鼓たたきの下手なかみなりの子が修業のため家出する。竜の子の協力で上達する。ある日、かみなりの親の危険を救い雲の上の我家に帰る。" ;
    schema:duration "17分" ;
    schema:identifier "NAE0601" ;
    schema:materialExtent "180m" ;
    schema:name "かみなりん子物語" ;
    schema:pagination "255" ;
    schema:producer "石川孝寿" ;
    schema:productionCompany "東京中央人形劇場" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0601> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1284>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "夢見童子" ;
    schema:about "少女画や抒情画の蕗谷虹児が原画担当、演出もかねた。宣伝用チラシに蕗谷が書いているが「美しい線、鮮麗な色彩、静かなる動きを求めた」そうだが、ドタバタ動画にはない静的な雰囲気の動画となってユニークな作品だが反面退屈な作品でもあった。" ;
    schema:audio "トーキー" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：伊藤宣二" ;
    schema:contentType "35mm" ;
    schema:contributor "撮影：石川光明", "構成・原画：蕗谷虹児", "背景：糸井俊二", "録音：森武" ;
    schema:dateCreated "1958年4月5日" ;
    schema:description "夢見童子がいつもの梅の木の下に現われ、昼寝をして夢を見ている。村の子供達は夢の支配者、童子に欲しい夢をもらいにやって来る。戦いの好きな男の子は金の太刀をくれと頼む。美しくなりたい少女は化粧用の銀の鏡が欲しいと頼む。だが、童子はそんな欲望のある子供には夢はくれない。子供達は怒って帰る。童子は悲しく思う。 ある日、心やさしい少女がやって来る。少女は貧しい家の子供たちにせめて卵一つでもと、鶏飼いの家で働き、お礼に卵をいくつかもらう。少女は寝ている童子にどんなに良い夢を見ても、夢から醒めたらひもじいだろうと、眠っている童子の手に大切な卵を置いて行く。童子は心やさしい少女の行為を喜び、少女に楽しい夢を与える。" ;
    schema:duration "16分" ;
    schema:identifier "NAE0602" ;
    schema:materialExtent "438m" ;
    schema:name "夢見童子" ;
    schema:pagination "256" ;
    schema:producer "赤川孝一、山本早苗" ;
    schema:productionCompany "東映教育映画部" ;
    schema:releaseDate "1958年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0602> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1285>
    rdf:type o:Item, schema:CreativeWork ;
