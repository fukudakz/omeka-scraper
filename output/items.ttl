    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "MAD MONSTER PARTY" ;
    schema:about "ビデオ・クラフト社との日米合作人形映画。怪物島に住むフランケンシュタイン男爵の跡目相続パーティに招かれたドラキュラ、ミイラ男、透明人間、狼男、ノートルダムのせむし男、ジキル博士とハイド氏、アマゾンの半魚人達が繰りひろげるドタバタ。キング・コングを“IT”として実名を出していないのは版権の関係だろう。結局、怪物島は大爆発。主人公のフェリックスと秘書のフランチェスカだけがボートで脱出する。\n登場人物・フランケンシュタイン男爵、ドラキュラ、ジキル博士とハイド氏、ノートルダムのせむし男、狼男、ボリス・カーロフ、フランケンシュタインの召使イゴール、ピーター・ローレー、アマゾンの半魚人、フェリックス・フランケン（主人公の青年）、フランチェスカ（フランケンシュタインの秘書）、 IT（キング・コング）" ;
    schema:actors "アラン・スイフト、ゲール・ガーネット、フィリス・デイラー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15444> ;
    schema:color "カラー" ;
    schema:composer "作曲：モーリー・ロウ", "作詞：ジュールス・バス" ;
    schema:contentType "35mm" ;
    schema:contributor "アシスタント・ディレクター：キゾー・ナガシマ （長島喜三）", "アニマジック・テクニシャン：タッド・モチナガ （持永只仁）", "エグゼクティブ・プロデューサー：ジョセフ・E・レヴィン", "キャラクター・デザイン：ジャック・ディヴィス", "ストーリー：アーサー・ランキンJr.", "人形アニメーター：太田サトル、中村武雄、真賀里文子、園哲太郎、見米豊", "監督：ジュールス・バス", "脚本：レン・コロブキン、ハーベイ・カーツマン" ;
    schema:correction "製作を更新 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:distribution "配給：エムバシー映画" ;
    schema:duration "1時間30分" ;
    schema:identifier "NAE0786" ;
    schema:name "MAD MONSTER PARTY" ;
    schema:pagination "286" ;
    schema:productionCompany "A Ramkin-Bass Production、MOMプロ" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0786> .

