    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かっぱのぱあ太郎" ;
    schema:about "動物漫画では丸味のあるやわらかいディズニータッチの絵で定評ある児童漫画家、花野原芳明が初めて動画を製作した。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽：伊藤宣二" ;
    schema:contentType "35mm" ;
    schema:contributor "原画・演出：花野原芳明", "撮影：森武雄", "背景：六郷僚一", "補佐：熊川正雄", "録音：森武" ;
    schema:dateCreated "1957年11月25日" ;
    schema:description "沼に住むカッパの子、ぱあ太郎はいたずら好き。蛙を追いかけ空カンに逃げこんだのを捕えると、缶詰と間違えた猿が横取り。遊び相手のいないぱあ太郎はモグラにまでバカにされる。いたずら子狸がリモコンの飛行機を使ってぱあ太郎をいぢめる。猿と狸が仲よく遊んでいるのを見るとシャクにさわって計略で仲間ゲンカをさせる。 これを見ていたモグラの注進で、猿と狸はぱあ太郎を追いかける。沼に逃げ帰ったぱあ太郎はとび込んだ時、底の石で頭を打ち大きな天罰のこぶが出来た。" ;
    schema:duration "14分" ;
    schema:identifier "NAE0572" ;
    schema:materialExtent "385m" ;
    schema:name "かっぱのぱあ太郎" ;
    schema:pagination "252" ;
    schema:producer "赤川孝一" ;
    schema:productionCompany "東映教育映画部" ;
    schema:releaseDate "1957年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0572> ;
    schema:volumeNumber "2" .

