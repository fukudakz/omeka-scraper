    o:title "椅子" ;
    schema:about "齣落しの技法を使用した実写で、画家の岡本太郎や永六輔など有名無名の五十六人を一人ずつ、何もない空部屋に一脚の椅子に15分間座らせ齣落しの微速度撮影をして各人の反応を観察したもの。一番動かなかったのは作家の広池秋子だったそうだ。カナダのノーマン・マクラレンの“隣人”（52年）や“いたずら椅子”（57年）と同趣向の作品。" ;
    schema:audio "トーキー" ;
    schema:awards "1964年カンヌ青年映画祭招待出品" ;
    schema:color "白黒" ;
    schema:composer "音楽：秋山邦晴" ;
    schema:contentType "35mm" ;
    schema:contributor "協力：ビデオ・プロモーション", "撮影・演出：久里洋二", "録音：奥山重之助" ;
    schema:dateCreated "1962年9月20日" ;
    schema:disambiguatingDescription "実写" ;
    schema:duration "20分" ;
    schema:identifier "NAE0659" ;
    schema:materialExtent "540m" ;
