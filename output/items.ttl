    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "安寿と厨子王丸" ;
    schema:about "森鴎外の原作をもとに新聞連載した話を田中澄江が脚色、薮下泰司、芹川有吾共同演出の東映創立十周年記念作品。" ;
    schema:actors "[安寿] 佐久間良子、[厨子王丸 （少年時代）] 住田知仁、[厨子王丸（青春時代）] 北大路欣也、[父・岩木判官] 宇佐美淳也、[母・八汐] 山田五十鈴、[山椒太夫] 東野英治郎、[長男・次郎] 平幹二朗、[次男・三郎] 水木襄、[関白・藤原師実] 山村聡、[娘・あや姫] 松島トモ子、[判官の上役・鬼倉陸奥守] 三島雅夫、[家来・安藤左内] 花沢徳衛、[岩木家の侍女・菊乃] 利根はる恵、[奴頭の権六] 富田仲次郎、[人買いの山岡太夫] 永田靖、[船頭・宮崎の甚八] 清村耕次、[船頭・佐渡の辰公] 潮健児、[岩木家の門番] 織田政雄、[国分寺の和尚] 明石潮、[あや姫の侍女] 新井茂子、[清水のならず者] 森弦太郎、[師実の使者] 増田順司、[鼡のチョン子] 武藤礼子、[子熊のモク] 大平透" ;
    schema:audio "トーキー" ;
    schema:awards "リミニ国際映画祭監督賞", "文部省特選" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16975>, <https://www.nihon-animation-eigashi.com/work-db/item/17584> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "作詞：木下忠司", "歌：松島トモ子、能沢佳子、コーロステルラ合唱団", "音楽：木下忠司、橘木創" ;
    schema:contentType "35mm" ;
    schema:contributor "トレース：進藤みつ子、本橋文枝、宮崎正子、吉田信子", "仕上検査：新納三郎", "動画監修：山本早苗", "動画：紺野修司、喜多真佐武、奥山玲子、永沢詢、寺千賀雄、吉田迪彦、杉山卓、堀川豊平 〔タイトルに出て来ないが動画に従事したスタッフ〕 堰合昇、大田朱実、小田克也、石井元明、相磯喜雄、生野徹太、中谷恭子、彦根範夫、小田部羊一、 竹内留吉、加藤洋子", "原画：大工原章、森康二、大塚康生、古沢日出夫、熊川正雄、楠部大吉郎", "彩色：林富喜江、川島純子、中島祥子", "撮影：大塚晴郷、中村一雄、東喬明", "構成：高橋勇", "演出：薮下泰司、芹川有吾", "編集：宮本信太郎、稲葉郁三", "美術：鳥居塚誠一", "考証：蕗谷虹児", "背景：浦田又治、横井三郎、千葉秀雄", "脚本：田中澄江（「よみうり少年少女新聞」連載）", "色彩設計：小山礼司", "製作進行：茂呂清一", "製作：大川博", "録音：空閑昌敏、森武", "音響効果：木村一" ;
