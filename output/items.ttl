    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "鉄ものがたり" ;
    schema:audio "トーキー" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "作曲：団伊玖麿" ;
    schema:contentType "35mm" ;
    schema:contributor "動画製作：東映動画 岡部冬彦、市野正二", "撮影：石川光明", "構成・脚本：伊勢長之助", "演出：前田一", "製作：小口禎三、坊野貞男" ;
    schema:dateCreated "1962年3月" ;
    schema:description "台所の擬人化された鉄製品の鍋やヤカン、スプーン等が真夜中、ダンスパーティを始める。朝になり元の場所に急いで戻る。空カンは屑カゴへ。屑鉄となって製作所へ。製鉄工場では製鉄工程を見せ、空カンや屑鉄は再び鉄となってビルの鉄骨や橋梁となる。一部はカンヅメとなって再び家庭へ戻って来る。" ;
    schema:duration "23分" ;
    schema:identifier "NAE0658" ;
    schema:materialExtent "620m" ;
    schema:name "鉄ものがたり" ;
    schema:pagination "265" ;
    schema:productionCompany "岩波映画製作所" ;
    schema:releaseDate "1962年4月22日" ;
    schema:sourceOrganization "鋼材俱楽部" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0658> ;
    schema:volumeNumber "2" ;
    schema:workPresented "日活系" .

