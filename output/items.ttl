    o:title "ちびくろさんぼとふたごのおとうと" ;
    schema:audio "トーキー" ;
    schema:author "ヘレン・バーマン" ;
    schema:color "白黒" ;
    schema:composer "音楽：加藤三雄" ;
    schema:contentType "35mm" ;
    schema:contributor "人形製作：川本喜八郎", "撮影：岸次郎", "演出：持永只仁", "美術：江口準次", "脚本：村治夫", "製作：稲村喜一" ;
    schema:dateCreated "1957年3月" ;
    schema:description "サンボに双児の弟が生まれた。両親の留守、サンボがお守りをしていると、山のハゲタカがすきを見て弟たちをさらう。子猿とインコの応援を得て無事取り戻す。" ;
    schema:duration "17分" ;
