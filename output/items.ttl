    schema:contentType "35mm" ;
    schema:correction "原作、原作者、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:identifier "NAE0065" ;
    schema:isBasedOn "「シノミヤコ」（1924年9月10日発行『お伽 正チヤンの冒険 貳の巻』所載）" ;
    schema:name "正ちゃんの冒険" ;
    schema:pagination "195" ;
    schema:releaseDate "大正年間作品（年度等詳細不明分）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0065> ;
    schema:volumeNumber "1" .

