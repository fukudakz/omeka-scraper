<https://www.nihon-animation-eigashi.com/work-db/api/items/1596>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:45+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "西遊記" ;
    schema:about "中国人民の抵抗運動に苦悩していた情報局では、宣撫活動の一環として飛行機から映画フィルムを投下することを計画。「ラーマ・ヤーナ」 「娘道成寺」（演出・市川崑）「西遊記」の三本を、糸操り、手使いの人形劇映画として製作した。 ここに掲げた二作品は部分的に動画手法（人形アニメ）が用いられている。なお演出の浅野竜麿の兄弟、浅野孟府は、昭和十年JO作品「かぐや姫」 （演出・田中喜次 音楽劇映画）のアニメ部分の人形を担当、好評であったそうだ。" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "演出：浅野竜麿" ;
    schema:identifier "NAE0914" ;
    schema:name "西遊記" ;
    schema:pagination "352" ;
    schema:producer "企画：森岩雄" ;
    schema:productionCompany "東宝" ;
    schema:releaseDate "不詳（1944年支那大陸投下用）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0914> ;
    schema:volumeNumber "2" .

