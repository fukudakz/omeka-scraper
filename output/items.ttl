<https://www.nihon-animation-eigashi.com/work-db/api/items/1458>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ようこそ宇宙人" ;
    schema:actors "真理よし子、ほか" ;
    schema:audio "トーキー" ;
    schema:author "星新一" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15509> ;
    schema:color "カラー" ;
    schema:composer "音楽：広瀬量平" ;
    schema:contentType "16mm" ;
    schema:contributor "協力：株式会社エコー", "撮影：吉岡謙", "演出：岡本忠成", "脚本：村治夫", "製作：村治夫" ;
    schema:correction "製作を更新 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:dateCreated "1966年5月" ;
    schema:description "ある遊園地のロボット案内嬢ロビンと鼠のマックは人気者。入口で「遠い所からようこそ」 と子供達を案内して回る。ある夜宇宙船が地球に接近。キル星から地球偵察に来た奇怪な宇宙人は遊園地に降りる。遊園地のロケットや飛行機を見て地球の軍事基地と間違えたのだ。ロボットのロビンは宇宙人に電子銃を突きつけられても一向に動ぜず「ようこそ遠い所から」と豆電車に乗せ、遊園地を案内して回る。宇宙人は地球人は平和な種属と判断し、本国へ帰って行く。ロボットのおかげで地球の危機は救われた。" ;
    schema:duration "14分" ;
    schema:identifier "NAE0776" ;
    schema:isBasedOn "「夜の事件」（朝日新聞日曜版掲載）" ;
    schema:materialExtent "156m" ;
    schema:name "ようこそ宇宙人" ;
    schema:pagination "282" ;
    schema:productionCompany "電通映画社、株式会社エコー" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0776> ;
    schema:volumeNumber "2" .

