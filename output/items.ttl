<https://www.nihon-animation-eigashi.com/work-db/api/items/640>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:09+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "お猿の三吉・突撃隊の巻" ;
    schema:about "\"お猿の三吉\"シリーズ第二作。猿の兵隊一行は降りしきる雪の広野を進軍。白熊軍の要塞からニョキニョキと大砲が顔を出した途端、猿軍めがけて弾丸の雨。猿軍も応戦。吹雪の中に敵味方の弾丸入り乱れ、三吉はその真中に投げ出される。勇敢な三吉、立ち上って戦車の上に飛びのり、弾丸の交通整理をはじめる。三吉は敵陣へ戦車を乗り入れ、爆弾三勇士をつのり、モグラ戦術など珍アイデアで突撃、ついに白熊軍の要塞を占領する。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "作曲：西垣鉄夫" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・監督：瀬尾光世", "録音：杉井幸一（PCL）" ;
    schema:distribution "東和商事映画部" ;
    schema:duration "9分" ;
    schema:identifier "NAE0254" ;
    schema:materialExtent "245m" ;
    schema:name "お猿の三吉・突撃隊の巻" ;
    schema:pagination "212" ;
    schema:productionCompany "日本マンガ・フィルム研究所" ;
    schema:releaseDate "1934年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0254> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/641>
    rdf:type o:Item, schema:CreativeWork ;
