<https://www.nihon-animation-eigashi.com/work-db/api/items/1317>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かぐや姫" ;
    schema:actors "里見京子、内村軍一、加藤玉枝、木下秀雄、斎藤隆、山内雅人" ;
    schema:audio "トーキー" ;
    schema:awards "1961年度教育映画祭優秀作品賞", "文部大臣奨励賞", "第九回キネマ旬報文化映画ベスト・テン第六位" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/11349> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：林光" ;
    schema:contentType "35mm" ;
    schema:contributor "アニメーション：井上真佐子、関口正子、中村協子、和田京子、寺司香智子", "効果：大野松雄", "同助手：清水富美子", "撮影：寺山威、三科博", "演出助手：古賀隆泰", "美術構成：清水耕蔵", "脚本・演出：渡辺和彦", "製作担当：伊藤治雄", "製作：古岡勝" ;
    schema:dateCreated "1961年3月" ;
    schema:description "プロローグで宇宙ロケットが発射され、人類が月へ行く事も夢ではなくなったと説明される。（この映画の製作された当時は宇宙開発の初期で、実際に人類が月に到着するのは四十四年七月二十日。アメリカのアポロ11号が偉業を達成する）昔の人々には月は大きな謎だったと、世界各国の月にまつわる物語を紹介。日本の竹取物語の話が動画になる。動画の技法は羽子板の押絵の様な立体感のあるユニークな技法やセル・アニメが使用された。かぐや姫が三人の求婚者に難題を出すが、一番目の石作皇子に天竺の“仏の鉢”を取 りに行かせる。この探検行のシークェンスが圧巻だといわれている。" ;
    schema:duration "27分" ;
    schema:identifier "NAE0635" ;
    schema:materialExtent "740m" ;
    schema:name "かぐや姫" ;
    schema:pagination "261" ;
    schema:producer "原正次、山本英夫" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1961年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0635> ;
    schema:volumeNumber "3" .

