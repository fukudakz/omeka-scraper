<https://www.nihon-animation-eigashi.com/work-db/api/items/1289>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ポロンギター" ;
    schema:about "四万三千齣の撮影を要したミュージカル仕立ての人形映画。" ;
    schema:audio "トーキー" ;
    schema:awards "第七回キネマ旬報文化映画ベスト・テン第四位", "第六回教育映画祭動画部門最高賞" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "作曲：林光" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーショ ン：有馬征子、新免郁子、千原玲子", "人形装置：高山良策、佐々木章", "振付：谷桃子バレー団", "撮影・照明：中村聖、平井寛", "脚本・演出：小野豪", "衣裳：高山とし子", "製作担当：神林伸一", "製作：古岡勝" ;
    schema:dateCreated "1959年9月5日" ;
    schema:description "貧しい花売り娘は美しい心の持主。この町に旅の貧しい老人がやって来てレストランへ入るが、お金を持ってないので放り出される。町の人は知らぬ顔。娘は老人をたすけ起こし、花が売れないのでお金もパンもあげられないが、せめて花でもと差出す。老人はいつの間にか消えて古びたギターが残されていた。娘がギターに触れると一人でギターは鳴り踊り出す。あまり楽しい曲なので娘も踊り出す。町の人々も皆踊り出し、皆は幸福な気分に酔った。花も全部売れた。娘はギターを大事に枕元に置いて寝る。夜中、泥棒が忍び込み、ギターを盗むが、ギターが町中に大きな音をボロン、ボロンと出したので、驚いて逃げ出す。 翌朝、広場でけんかしていた兄弟もギターの美しい音色に踊り出す。再び町中の人が楽しく踊る。そこへ不思議な老人が現われ、静かにギターを持ち去る。" ;
    schema:duration "27分" ;
    schema:identifier "NAE0607" ;
    schema:materialExtent "743m" ;
    schema:name "ポロンギター" ;
    schema:pagination "256" ;
    schema:producer "原正次、山本英雄" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1959年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0607> ;
    schema:volumeNumber "3" .

