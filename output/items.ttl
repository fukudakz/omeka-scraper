    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "元禄恋模様・三吉とおさよ" ;
    schema:about "\"お猿の三吉\"シリーズの第四作。第三作\"おいらの艦隊\"の録音が遅れて、第四作が先に公開。大阪、神戸、京都の松竹座で封切られるが好評で続映された。昭和8年封切のRKO作品 「キングコング」のパロディー版時代劇。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/32467>, <https://www.nihon-animation-eigashi.com/work-db/item/32468> ;
    schema:color "白黒" ;
    schema:composer "西垣鉄雄" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・監督：瀬尾光世" ;
    schema:description "桜満開の春、足軽の三吉も花見としゃれこむ。ある旗本の花見の宴で、一人娘のおさよが踊っている。美しいおさよをさらいにギャング団が出現、大騒動になる。三吉が登場し、ギャングからおさよを奪い返し、花見の宴は再開される。" ;
    schema:distribution "東和商事映画部" ;
    schema:duration "10分" ;
    schema:identifier "NAE0255" ;
    schema:materialExtent "274m" ;
    schema:name "元禄恋模様・三吉とおさよ" ;
    schema:pagination "212" ;
    schema:productionCompany "日本マンガ・フィルム研究所" ;
    schema:releaseDate "1934年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0255> ;
    schema:volumeNumber "1" .

