    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "アラビアンナイト・シンドバッドの冒険" ;
    schema:about "当初題名「アラビアンナイト・素晴しき冒険」改題。" ;
    schema:actors "[シンドバッド] 木下秀雄、[アリー] 黒柳徹子、[船長ハムディ] 滝口順平、[アブダラ] 太宰久雄、[カシム] 辻村真人、[アーマッド王] 永井一郎、[王妃アミーナ] 新道乃里子、[サミール姫] 里見京子、[トルファ大臣] 川久保潔、[漂着した老船員] 巌金四郎、[その他] 斎藤隆、古賀浩二、東京放送劇団" ;
    schema:audio "トーキー" ;
    schema:awards "文部省特選", "第一回リミニ国際動画映画祭監督賞", "第四回ヴェネチア国際児童映画祭サンマルコ青銅賞受賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/13043>, <https://www.nihon-animation-eigashi.com/work-db/item/18555> ;
    schema:color "カラー" ;
    schema:composer "作詞：米山正夫", "合唱：二期会", "歌：デニー・白川、真理ヨシコ、太宰久夫、松岡ユキ", "音楽：冨田勲、米山正夫" ;
    schema:contentType "35mm" ;
    schema:contributor "トレース：進藤みつ子、滝川紀子、坂本洋子、佐藤信子", "仕上検査：新納三郎", "効果：木村一", "動画監修：山本早苗", "動画：竹内留吉、堰合昇、小田克也、生野徹太、中谷恭子、大田朱美、小田部羊一、月岡貞夫、勝田稔男、吉田茂承、相磯嘉雄、菊池貞雄、児玉喬夫、小林和子、長沼寿美子 〔タイトルに出て来ないが動画に従事したスタッフ〕 堀川豊平、石井元明、笠井晴子、福島信行、山田みよ、生形昌代、菊地勝子、窪田勝子、斎藤賢、高木厚、林重行、岡迫亘弘、梅田英俊、田村真也、平田敏夫、森英樹、尾崎茂雄、赤堀幹治、上口照人、黒沢隆夫、松原明徳、柴田圭子、金山通弘、木野達児、小林敏明、坂野隆雄、平川謹之助、橋本隆範、木村圭一郎、佐藤明、我妻宏、森下圭介、永木総博、小泉謙二", "原画：大工原章、古沢日出夫、熊川正雄、大塚康生、楠部大吉郎、奥山玲子、喜多真佐武、勝井千賀雄", "彩色：小野弘子、渡部益子、林富喜江、高橋佳子", "撮影：杉山健児、中村一雄", "演出：薮下泰司、黒田昌郎", "編集：稲葉郁三", "美術：進藤誠吾、深井肇", "背景：福本智雄、片倉和子、杉本英子、伊藤主計、影山勇、千葉秀雄", "脚本：手塚治虫、北杜夫", "舞踊：榊原帰逸", "色彩設計：浦田又治", "製作進行：茂呂清一", "記録：鈴木安津子", "録音：空閑昌敏、森武" ;
    schema:dateCreated "1962年5月" ;
    schema:disambiguatingDescription "東映スコープ" ;
    schema:duration "1時間21分" ;
    schema:identifier "NAE0661" ;
    schema:materialExtent "2228m" ;
