    schema:contentType "35mm" ;
    schema:contributor "演出・作画：鈴木宏昌、古沢秀雄" ;
    schema:description "家畜村の軍需工場へキツネのスパイが入り込み、飛行機や戦車をこっそりと撮影。猿のスパイは書類を盗み出そうとするが、動物達に追いかけられ、自動車から飛行機へと乗り継いで逃げるが、ついに捕ってしまう。最後に画面いっぱいに、\"スパイを防ぎませう\"とスローガンが出る。 主題歌「要心節」。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0382" ;
    schema:materialExtent "294m" ;
    schema:name "動物防諜戦" ;
    schema:pagination "225" ;
    schema:productionCompany "国光教育映画" ;
    schema:releaseDate "1941年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0382> ;
    schema:volumeNumber "1" .

