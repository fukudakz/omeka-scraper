<https://www.nihon-animation-eigashi.com/work-db/api/items/1338>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ジャータカものがたり・きんいろのしか" ;
    schema:alternateName "きんいろのしか　ジャータカものがたり" ;
    schema:audio "トーキー" ;
    schema:awards "東京都教育映画コンクール銀賞" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/13547> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：木下忠司" ;
    schema:contentType "35mm" ;
    schema:contributor "アニメーション：和田京子", "撮影：竹内則郎", "美術：清水耕蔵", "脚本・演出：渡辺和彦", "製作担当：神保まつえ", "製作：原正次" ;
    schema:correction "別タイトルを追加 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:dateCreated "1962年11月" ;
    schema:description "昔、インドの城に可愛いい王女がいた。金色の鹿の夢を見た王女は、王様にその鹿が欲しいとねだった。王は金色の鹿を捕えた者には賞をやるとおふれを出した。一人の少年がおじいさんから、昔、山奥の湖のそばで美しい歌を唄う金色の鹿を見たと教えられ、象に乗って出かける。やっと湖に着き、ワナを仕掛けて待っていると金色の鹿が水をのみに来てかかる。金色の鹿は痛さをこらえ、仲間の鹿が飲み終わるのを待つ。ついに悲鳴をあげたので、仲間の鹿は逃げ出すが、金色の鹿の弟と妹は勇気を出し兄鹿を救おうとする。心をうたれた少年は金色の鹿を捕えるのをやめた。鹿はお礼に金色の毛を蓮の葉に包んでくれる。城へ帰った少年は王女と王にその話をし、蓮の葉を開くと美しい音楽が鳴りひびいた。レリーフ・アニメ。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0656" ;
    schema:materialExtent "301m" ;
    schema:name "ジャータカものがたり・きんいろのしか" ;
    schema:pagination "265" ;
    schema:producer "鈴木学術財団" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1969年（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0656> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1339>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:43+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:50+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ジャータカものがたり・しろいぞう" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/80115> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：木下忠司" ;
    schema:contentType "35mm" ;
    schema:contributor "人形アニメーション：有馬征子", "人形：佐々木章", "撮影：秦吏史、金子泰生", "美術：酒向満", "脚本・演出：神保まつえ", "製作：原正次" ;
    schema:dateCreated "1962年12月" ;
    schema:description "インドの山奥に白い象がいた。近くの湖のそばに盲の母象がいた。白い象は仲間に頼んで時々果物を母に届けてもらっていた。久しぶりに母に会いに行き果物が届いていないことを知った。仲間の象が食べていたのだ。白象は仲間と別れ母と暮すことになった。ある日、山道で迷った男を助け、ふもとまで送ってやったが、この男はずるい心の持主で、珍しい白象のことを王様に告げた。王は白象の捕獲を命じ、白象は母に危険がかかるのを恐れて無低抗で捕まった。王は大喜びで花を飾り、ごち走をくれるが、少しも食べない。母を残した白象の心配事を知った王は反省し、すぐ山へ帰してやる。盲の母の背に、やさしく湖の水をかけてやる白象は嬉しそうだった。人形映画。" ;
    schema:duration "13分" ;
    schema:identifier "NAE0657" ;
    schema:materialExtent "356m" ;
    schema:name "ジャータカものがたり・しろいぞう" ;
    schema:pagination "265" ;
    schema:producer "鈴木学術財団" ;
    schema:productionCompany "学研映画局" ;
    schema:releaseDate "1969年（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0657> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1340>
    rdf:type o:Item, schema:CreativeWork ;
