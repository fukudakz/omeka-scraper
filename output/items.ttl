<https://www.nihon-animation-eigashi.com/work-db/api/items/661>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "いなばの国の兎さん" ;
    schema:alternateName "いなばのうさぎ", "白兎" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：瀬尾光世" ;
    schema:description "因幡の国の白兎はある嵐の夜、大波にさらわれ、向いの島に打ち上げられた。故郷恋しさに、ワニ（鰐鮫ではない）をだましたので皮をはがされてしまうが、情深い大国主命に救われる。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0275" ;
    schema:materialExtent "266m" ;
    schema:name "いなばの国の兎さん" ;
    schema:pagination "214" ;
    schema:productionCompany "旭物産合資会社映画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0275> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/662>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "一寸法師ちび助物語" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：瀬尾 光世" ;
    schema:description "指に足りない一寸法師ちび助は都に上って出世したいと田舎から出て来た。おわんの舟に箸のカイで長旅の末、都の岸辺についた。土堤のつる草を縄バシゴに登ったちび助、やっと都大路へ来たのは大臣の屋敷前。お目通りが許され、手のひらの踊りが気に入った大臣は、ちび助を家来に召しかかえた。ある春の日、姫の桜見物のお供で清水へ詣る途中、淋しい山道にさしかかると、かねて都人を苦しめていた山鬼が姫にとびかかる。 ちび助は腰の一刀で鬼の足の甲を突き刺す。驚いた山鬼は姫を離しちび助をつかまえようとする。草むらにかくれたちび助は、スタンプで自分の姿を沢山複製にして作る。ちび助の一隊はマッチの弾丸で鬼をやっつける。鬼が忘れたうちでのこづちで立派な若者になる。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0276" ;
    schema:materialExtent "274m" ;
    schema:name "一寸法師ちび助物語" ;
    schema:pagination "214" ;
    schema:productionCompany "旭物産合資会社映画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0276> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/663>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "お山の大将" ;
    schema:about "森永練乳のCMフィルム。" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：瀬尾 光世" ;
    schema:description "足柄山の山奥に赤ん坊が捨てられていた。猿のお母さんに拾われ、白猿と名をつけて可愛がられた。ある日、山では猿軍対白兎軍の野球試合が始まり、猿軍振わず惨敗しかけるが、ピンチヒッターの白猿は大ホームランを放つ。球はグングン伸びて昼寝の熊に当たる。怒った熊は白猿と勝負と相撲を取るが白猿の勝。翌日から白猿は足柄山の大将となり\"金太郎\"と呼ばれる様になった。" ;
    schema:distribution "東和商事映画部" ;
    schema:duration "10分" ;
    schema:identifier "NAE0277" ;
    schema:materialExtent "265m" ;
    schema:name "お山の大将" ;
    schema:pagination "214" ;
    schema:productionCompany "旭物産合資会社映画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0277> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/664>
