    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "忍術火の玉小僧・江戸の巻" ;
    schema:about "作画の酒井七馬は、昭和22年、手塚治虫と共作で「新宝島」の漫画を出版し、今日の手塚治虫を生んだ育ての親でもある。当時はアニメーターとして活躍していた。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17266-1> ;
    schema:color "白黒" ;
    schema:composer "白木義信" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：舟木俊一、永久博郎、酒井七馬", "監督：田中与志" ;
    schema:description "馬鹿殿様が日本橋を市中巡察の途中、美しい娘のまりつき姿が目にとまる。娘に手を出したので、娘は逃げ回る。火の玉小僧が娘を救いに捕方相手に大暴れする。" ;
    schema:distribution "日活" ;
    schema:identifier "NAE0294" ;
    schema:name "忍術火の玉小僧・江戸の巻" ;
    schema:pagination "216" ;
    schema:productionCompany "日活京都撮影所漫画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0294> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/681>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
