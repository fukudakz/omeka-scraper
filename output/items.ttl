    o:title "花 （A Flower）" ;
    schema:about "四十二年四月からカナダ、モントリオールで開かれた万国博PRのため、市が募集した五十秒でまとめる国際映画祭に二位で入賞。シルバー・メダル賞を受賞した作品。" ;
    schema:color "カラー" ;
    schema:contentType "35mm" ;
    schema:contributor "動画・演出・撮影：久里洋二" ;
    schema:description "大地に種をまき、水をやり、芽が出る。ぐんぐん成長し大きな花が一輪咲く。そこから巨大な女が生まれ、男を押しつぶし、やがて地球いっぱいの子供を繁殖させる。" ;
    schema:duration "50秒" ;
    schema:identifier "NAE0799" ;
    schema:name "花 （A Flower）" ;
    schema:pagination "288" ;
    schema:productionCompany "久里実験漫画工房" ;
    schema:releaseDate "1967年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0799> ;
    schema:volumeNumber "1" .

