    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "おとぎの世界旅行" ;
    schema:about "劇場公開の三作目だが、事実上、おとぎプロ最後の作品となった。やはりオムニバス作品の弱みが出て、個々の作品は面白いが、全体のまとまりからみると散漫になったのは惜しまれる。つなぎ部分の動画が楽しく、第三話“竜巻に好かれた赤いシャツ”が背景に浮世絵を用いてユニーク。特別出演の徳川夢声は、模型の機関車を齣撮りで動かした“勇敢な煙突号”のナレーション担当。" ;
    schema:actors "木下秀雄、辻村直人、上田敏也、関根信昭、真野純、堀絢子、牧村右子", "特別出演：徳川夢声" ;
    schema:audio "トーキー" ;
    schema:color "カラー" ;
    schema:composer "音楽：団伊玖麿" ;
    schema:contentType "35mm" ;
    schema:contributor "トレース・彩色：長井克子、関根スミ子、木村協子、玉井縫子、前田道子、佐藤松子、小山昭子、市原タイ子、太田喜美子、赤塚イシ子、塩野千鶴子", "トレース：永田敏郎", "動画：鈴木伸一、町山充弘、秦泉寺博、山本栄一、甲藤征史、山田幸弘、滝口明治、斎藤博、島村幸重、壬生理、岡田英美子", "台詞演出：佐分銅也", "撮影：小松義幸", "監督助手：鈴木伸一", "背景：中原健喜、鈴木伸一", "製作・監督：横山隆一", "録音：国島正男" ;
    schema:disambiguatingDescription "ワイド" ;
    schema:distribution "配給：東宝" ;
    schema:duration "1時間16分" ;
    schema:identifier "NAE0662" ;
    schema:materialExtent "2094m" ;
    schema:name "おとぎの世界旅行" ;
    schema:pagination "266" ;
    schema:productionCompany "おとぎプロダクション" ;
    schema:releaseDate "1962年8月25日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0662> ;
    schema:volumeNumber "6" ;
    schema:workPresented "東宝系" .

