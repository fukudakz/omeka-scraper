<https://www.nihon-animation-eigashi.com/work-db/api/items/482>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:05+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "舌切り雀" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "山本早苗", "金井木一路" ;
    schema:description "昔、正直で親切なおじいさんが、猫につかまって苦しむ雀を助けた。山へ芝刈りに行った 留守、雀はカゴから抜け出て、隣りのおばあさんが洗濯に使うノリをなめてつかまり、舌を切られた。雀をたずねておじいさんは山中へ。日が暮れると雀の家から迎えに来る。ごちそうをよばれ、 おみやげに軽い方のツヅラをもらい、家で開けてみると宝物が一ぱい。それを見た隣の欲深のおばあさんは雀の家へ出かけ、重いツヅラをもらうが、 中から出て来たのはお化けばかり。" ;
    schema:identifier "NAE0096" ;
    schema:name "舌切り雀" ;
    schema:pagination "196" ;
    schema:productionCompany "東京線画フィルム製作所" ;
    schema:releaseDate "1928年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0096> ;
    schema:volumeNumber "1" .

