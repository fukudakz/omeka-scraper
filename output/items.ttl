    o:title "一本足のきりぎりす" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:composer "音楽：尾崎美雄" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：庵原和夫", "撮影：芦田豊", "背景：福村林平", "脚色・演出：芦田いわを" ;
    schema:dateCreated "1955年3月" ;
    schema:description "一本の足をなくしたキリギリスが道端のお地蔵さんに片足のありかを教えられ、松葉杖をつき遠い三角山めざして探しに行く。苦心の末、やっとたどり着くが、そこには何もなくだまされたことを知る。怒ったキリギリスは超スピードで元に戻り、お地蔵さんに何もなかったと文句を言う。しかし、お地蔵さんから苦労したおかげで一本足でも二本足と変りがないとさとされる。" ;
    schema:distribution "配給：奥商会" ;
    schema:duration "10分" ;
    schema:identifier "NAE0542" ;
    schema:materialExtent "367m" ;
    schema:name "一本足のきりぎりす" ;
    schema:pagination "246" ;
    schema:productionCompany "芦田漫画映画製作所" ;
    schema:releaseDate "1955年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0542> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1225>
