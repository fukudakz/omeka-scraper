<https://www.nihon-animation-eigashi.com/work-db/api/items/656>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ミー坊と狼" ;
    schema:audio "トーキー" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司" ;
    schema:description "今夜はお月見。兎のミー坊はお母さんの言いつけで、おばあさんに月見ダンゴを届けに行く。途中出会った狸と猿にダンゴをあげる。狼が出てきてやさしくするので、つい気を許しおばあさんの家へ行くと言う。先回りした悪狼はおばあさんの家の戸をたたく。ミー坊が来たと戸を開けると狼が立っているので驚いたおばあさん逃げ出し近くの木の穴にかくれる。ミー坊、狼がおばあさんに変装して寝ているのも知らず、狼に近づく。いきなり飛びかかって来た狼に驚いたミー坊、救いを求めると狸や猿がかけつけ、狼と闘うが狼もさるものへこたれない。最後に狸が化けた橋にだまされた狼は谷川へ落ちてゆく。悪狼のいなくなった兎の村では助けてくれた狸や猿も招待、盛んな月見の踊りが広げられた。「赤頭巾」の話のパロディー。" ;
    schema:duration "9分" ;
    schema:identifier "NAE0270" ;
    schema:materialExtent "258m" ;
    schema:name "ミー坊と狼" ;
    schema:pagination "213" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0270> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/657>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:media <https://www.nihon-animation-eigashi.com/work-db/api/media/877> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:primary_media <https://www.nihon-animation-eigashi.com/work-db/api/media/877> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "海の水はなぜからい" ;
    schema:about "東北地方に伝わる民話を動画化したもの。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17341> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：村田安司", "飜案・脚色：青地忠三" ;
    schema:description "金持だが欲深な兄と、貧乏だが正直者の弟がいた。正月前、兄に餅の無心をしたが断わられ、とぼとぼ帰る途中、丸木橋で落ちかけていた老人を救う。老人はお礼に、不思議な森の小人たちのことを教え、小人の好物のマンジュウをくれる。森へ来た弟は、小人達の仕事を手伝い、マンジュウと交換に「宝の小臼」をもらう。欲しいものが何でも出て来る臼のおかげで貧乏な弟は村一番の金持になる。欲深な兄は弟の臼を盗み出し、離れ小島で一人でぜいたくしようと、小舟に小臼と食料を積んで海へ。沖へ出た兄は塩を積んで来なかったことに気づき、聞き覚えた呪文を唱えると、出るわ出るわ船の中は塩の山。しかし臼をとめる方法を知らなかったので、塩は船を埋めつくし、ついに沈没。曰は海底でいつまでも回り続け、塩を出したので、いまでも海の水はからいのだという話。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0271" ;
    schema:materialExtent "300m" ;
    schema:name "海の水はなぜからい" ;
    schema:pagination "214" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0271> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/658>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "塙団右衛門化物退治の巻" ;
    schema:about "14年トーキー版を製作。作曲、指揮・ 西垣鉄雄、録音・日本ラヂオトーキー製作所。夕イトルも\"証城寺の狸噺子\"と改題し、東和商事映画部配給で再公開。戦後三幸映画社から出た8ミリ版では「豪傑一番乗り」と改題されている。片岡作品中最高の快作。" ;
    schema:alternateName "証城寺の狸囃子", "豪傑一番乗り" ;
    schema:audio "サイレント" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17369>, <https://www.nihon-animation-eigashi.com/work-db/item/22361>, <https://www.nihon-animation-eigashi.com/work-db/item/32464> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画監督：片岡芳太郎", "脚色・監督： 魔須多和弘" ;
    schema:description "武者修業の途中、ある城下で化物退治したものに金千両を与えるとの高札を見た団右衛門が古寺に乗り込むが、美女に化けた狸の術中に陥り、目を廻してしまう。してやったりと狸達は首領狸を中心に無礼講の大酒盛り、目を覚した団右衛門は狸どもを鉄棒でなぎ倒し、丹下左膳に化けた首領狸と一騎打ち、ついにこれを退治して殿様より千両箱を貰う。" ;
    schema:identifier "NAE0272" ;
    schema:name "塙団右衛門化物退治の巻" ;
    schema:pagination "214" ;
    schema:productionCompany "日本マンガフィルム研究所" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0272> ;
    schema:volumeNumber "1" .

