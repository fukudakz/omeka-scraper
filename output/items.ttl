<https://www.nihon-animation-eigashi.com/work-db/api/items/1243>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ビールむかしむかし" ;
    schema:about "朝日ビールのPR人形映画。" ;
    schema:audio "トーキー" ;
    schema:awards "1956年度第二回全日本PR映画コンクール通産大臣賞、最優秀作品及び色彩部門第一位", "三十一（1956）年度キネマ旬報文化映画ベストテン第九位", "三十一（1956）年度教育短篇映画ベストテン第四位" ;
    schema:color "イーストマン・カラー" ;
    schema:composer "音楽：服部正" ;
    schema:contentType "35mm" ;
    schema:contributor "セロファン影絵；大藤信郎", "人形デザイン：土方重巳", "人形操作：持永只仁", "人形製作：川本喜八郎", "動画：日本アニメーション映画社", "撮影：岸次郎", "照明：鈴賀隆夫", "美術：江口準次", "脚色・演出：飯沢匡", "製作進行：加藤守男", "製作：小畑敏一、稲村喜一", "録音：加藤一郎" ;
    schema:dateCreated "1956年7月" ;
    schema:description "CMに登場するほろにが君の人形がビール博物館へ案内。人類誕生と共にアルコールの歴史も始まる。世界で最初にビールを飲んだ古代バビロニア人のハニワ人形の踊り、エジプトのピラミッドの壁画のレリーフがビールを飲む。中世ドイツでは僧院がビール製造の中心となる。チェコのピルゼン、ドイツのミュンヘンが二大ビールの生産地となり、一八五〇年ペルリの来航（この部分が大藤のセロファン影絵）により日本にビールが渡来。日本で最初に飲む光栄に浴したのはチョンマゲの武士であった。そして明治年間、北海道で最初の国産ビールが生産され、今日の大企業による量産になった経過が説明される。" ;
    schema:duration "12分" ;
    schema:identifier "NAE0561" ;
    schema:materialExtent "320m" ;
    schema:name "ビールむかしむかし" ;
    schema:pagination "250" ;
    schema:productionCompany "電通映画社、人形芸術プロダクション" ;
    schema:releaseDate "1956年" ;
    schema:sourceOrganization "朝日麦酒株式会社" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0561> ;
    schema:volumeNumber "1" .

