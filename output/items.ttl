    schema:correction "配給、フォーマット、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "タヌ公チームとウサ公チームの野球試合 狸軍優勢のうちに試合は進み、五回の攻撃で狸軍キャプテンの走者一掃の大ホームラン。ボールは森の中に落ち、ヒキ蛙が卵と間違えてのみ込むが溶けないので苦しむ。ボール探しの兎らが助けてくれて、やっとはき出すが、ボールがつかいものにならず、遂にドロンゲームになる。" ;
    schema:distribution "提供：横浜シネマ商会", "配給 [関東]：岡本洋行", "配給 [関西]：奥商会" ;
    schema:duration "15分" ;
    schema:identifier "NAE0157" ;
    schema:materialExtent "277m" ;
    schema:name "おいらの野球" ;
    schema:pagination "201" ;
    schema:productionCompany "横浜シネマ商会" ;
    schema:releaseDate "1930年3月（発売）" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0157> ;
    schema:volumeNumber "1" .

