<https://www.nihon-animation-eigashi.com/work-db/api/items/1450>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:44+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T16:09:26+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "殺人狂時代 （AU FOU!）" ;
    schema:about "あらゆる“殺し”のパロディ。例えば“嫉妬”という一篇は、短距離ランナーの男女がスタート・ライン上でウォーミングアップ。男、あたりを見回し、すきを見て女にチュッとキス。スタート。スターターは久里作品に必ず登場する巨大な女。号砲用のピストルが鳴ると男は即死。女一人走って行く。その他、孤島で救いを求める男。救助に向かった汽船がオーバーランして孤島に乗りあげ、男は即死とか、ジャスト・マリッドの車を運転している新婚の女。車のうしろにひっぱっているのは空カンならぬバラバラの男の死体。中でもブラック・ユーモアの傑作は「至誠」と大書した垂れ幕を背に三島由紀夫とおぼしき軍服姿の男。ボタンをはずした胸に胸毛がチラリと見える。やおら刀をとって十文字に切腹。中から出て来たのは赤き血ならぬ札束がゾクゾク。あわててかき集める男。全十三話で構成。いずれも一分少々に凝縮されたナンセンス・ギャグ。海外版は10分に短縮された。'67年オーバーハウゼン短編映画祭最優秀賞。'67年シカゴ映画祭ゴールデン・ヒューゴー賞受賞。'67年6月15日からフランスのアヌシーで開かれた第七回国際動画映画祭で特別招待作品として上映予定だったが、フランスのマヌエル・オテロ作品「アレス対アトラス」が「殺人狂時代」 のアイデア盗用で上映中止という一件があった。皮肉にも問題のオテロ作品がグランプリを獲得した。第三回「アニメーション・フェスティバル」で公開。" ;
    schema:awards "1967年オーバーハウゼン短編映画祭最優秀賞", "1967年シカゴ映画祭ゴールデン・ヒューゴー賞受賞" ;
    schema:color "白黒" ;
    schema:composer "音楽：山崎宏" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：久里洋二、古川肇", "演出：久里洋二" ;
    schema:duration "15分" ;
    schema:identifier "NAE0768" ;
    schema:name "殺人狂時代 （AU FOU!）" ;
    schema:pagination "281" ;
    schema:productionCompany "久里実験漫画工房" ;
    schema:releaseDate "1966年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0768> ;
    schema:volumeNumber "1" .

