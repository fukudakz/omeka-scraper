    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "森の野球団" ;
    schema:about "この映画にはミッキーマウス、ミニーマウス、ベティブープも登場する。仕合の途中で、狐が姫に、狸が奴に化け歌舞伎調になる。狸の声は政岡氏、狐の声は同夫人が吹込んでいる。主題曲は神田小唄。" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17373>, <https://www.nihon-animation-eigashi.com/work-db/item/19934-1>, <https://www.nihon-animation-eigashi.com/work-db/item/20064>, <https://www.nihon-animation-eigashi.com/work-db/item/32503> ;
    schema:color "白黒" ;
    schema:composer "伴奏：政岡映画音楽部", "音楽指揮：日立二郎" ;
    schema:contentType "35mm" ;
    schema:contributor "監督：原田誠一", "録音：J・O・トーキー・スタヂオ" ;
    schema:description "森の動物達の野球試合。ライオン・チームとピョン吉主将のウサ公チームの対戦。クモがバックネットを張り、森の元老、羊の始球式で、猫がサイレン役。試合はずる賢いライオン軍優勢で、九回裏、ピョン吉のガール・フレンドのウサ子はたまらず応援団長を買って出る。ピョン吉の打った大ホーマーで試合は逆点勝ち。" ;
    schema:duration "8分" ;
    schema:identifier "NAE0262" ;
    schema:materialExtent "227m" ;
    schema:name "森の野球団" ;
    schema:pagination "213" ;
    schema:productionCompany "政岡映画美術研究所" ;
    schema:releaseDate "1934年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0262> ;
    schema:volumeNumber "1" .

