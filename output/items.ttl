    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "かっぱ川太郎" ;
    schema:about "二十六年一月から朝日新聞の小学生向き週刊紙「小学生朝日」に連載された清水崑のかっぱ村の漫画の動画化。子供向きのかっぱ漫画が好評で、のち「週刊朝日」に大人向きの「かっぱ天国」 を連載するきっかけとなった。" ;
    schema:actors "解説：阿里道子" ;
    schema:audio "トーキー" ;
    schema:author "清水崑" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16097> ;
    schema:color "白黒" ;
    schema:composer "詩：サトウ・ハチロー", "音楽：服部正" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・動画：日動映画", "作画主任：古沢日出夫", "作画演出：薮下泰司", "効果：江口孝男", "動画：森康二、市野正二、近藤進、諸橋一、長井泰治、岡田弥生", "撮影：高城泰策、石川高明、山田耕造", "背景協力：六浦光雄", "背景協力：大工原章、笹森圭", "脚本：飯沢匡", "製作進行：西原春人", "製作：三井高孟、吉岡憲司", "録音所：国際ラジオセンター", "録音：寺尾幸男" ;
    schema:dateCreated "1954年4月" ;
    schema:description "清水崑の直筆で可愛いい子供のかっぱの一筆描きで映画は始まる。子供の川太郎が水中で大ウナギを捕まえたとたん投網をかぶされる。引上げたのは両親のかっぱ。親子でかっぱ相撲を見物したり平和なかっぱ村での風景。嵐がやって来て川には魚が一匹もいなくなる。村では食糧対策に大わらわ。川太郎は友達の女の子とトンボ捕りに出かけ、野犬に追いかけられ山奥に逃げ込み野宿する。翌朝、上流の川には魚がいっぱいいるのを見つける。嵐のため山崩れで川の流れがせき止められていたのだ。これを発見した川太郎は村に急報。かっぱ村総出で川の大岩を撤去して、川には再び魚が戻り、村は平和になる。" ;
    schema:distribution "提供：朝日新聞社", "配給：NCC" ;
    schema:duration "19分" ;
    schema:identifier "NAE0538" ;
    schema:materialExtent "508m" ;
    schema:name "かっぱ川太郎" ;
    schema:pagination "245" ;
    schema:producer "朝日新聞社" ;
    schema:productionCompany "三井芸術プロダクション" ;
    schema:releaseDate "1954年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0538> ;
    schema:volumeNumber "2" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1221>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:49+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "花と蝶" ;
    schema:actors "台詞：七曜会" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/17382> ;
    schema:color "コニ・カラー" ;
    schema:composer "音楽：紙恭輔" ;
    schema:contentType "35mm" ;
    schema:contributor "作画・演出：大藤信郎", "背景：宮義ふみを" ;
    schema:dateCreated "1954年10月" ;
    schema:description "擬人化された白い蝶と赤い蝶、黄色の蝶が春の光を浴びて遊んでいる。巣から落ちて泣いている小鳥のヒナを助けてやる。やがて大雨となり、蝶たちは白ユリに雨宿りを頼むが、白い蝶しか入れないという。仲よしの三人の蝶は仕方なく紅バラに頼むが、ここでも赤い蝶しか駄目と断わられる。最後に黄色のチューリップに雨宿りを頼むが黄色い蝶のほかは断わられ、三人一緒に雨を避ける場所をさがすが、風雨は強く、羽は次第に重くなって来る。それを見た小鳥のヒナは木の葉を落してくれ、蝶たちはそれをかぶって雨宿りする。間もなく雨もあがり、お日様が輝き、蝶たちも元気を取り戻す。三人の蝶を赤、白、黄と明確に色別したのはカラーの効果を考えての結果だろうが、妙に泥臭い作品。" ;
    schema:distribution "配給：奥商会" ;
    schema:duration "10分" ;
    schema:identifier "NAE0539" ;
    schema:materialExtent "272m" ;
    schema:name "花と蝶" ;
    schema:pagination "245" ;
    schema:productionCompany "千代紙映画社" ;
    schema:releaseDate "1954年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0539> ;
    schema:volumeNumber "1" .

