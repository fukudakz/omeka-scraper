    schema:actors "解説：七尾伶子" ;
    schema:alternateName "７ひきのこやぎ" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/80010> ;
    schema:color "白黒" ;
    schema:composer "音楽：若山浩一" ;
    schema:contentType "16mm" ;
    schema:contributor "美術：上田悌三", "脚本・演出・撮影：高橋克雄", "製作：庄司洵、高橋克雄" ;
    schema:correction "製作を更新、別タイトルを追加 [令和7年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "母さん山羊が買物に行った留守、七匹の子山羊が空腹の狼にだまされ、一番小さい七ちゃんを残して皆食べられてしまう。帰った母さんと七ちゃんは昼寝をしている狼のお腹から子山羊を助け出し、かわりに石をつめておく。人形映画。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0735" ;
    schema:materialExtent "120m" ;
    schema:name "七ひきのこやぎ" ;
