    o:title "お猿三吉・闘う潜水艦" ;
    schema:color "白黒" ;
    schema:composer "西垣鉄雄" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：片岡芳太郎", "後援：海軍省" ;
    schema:description "海軍潜水学校で潜水艦について授業を受けたお猿たちは、いよいよ潜水艦で戦場へ。三吉の乗った潜水艦も大活躍。三吉は特攻隊となり軍刀にとびのり敵陣へ。刀は一人で部屋の中に突進し壁のルーズベルトの額まで進む。ルーズベルトの似顔が手を合せて命乞いをするギャグもあったそうだ。" ;
    schema:identifier "NAE0421" ;
    schema:name "お猿三吉・闘う潜水艦" ;
    schema:pagination "231" ;
    schema:producer "高橋幸次郎" ;
    schema:productionCompany "日本マンガフィルム研究所" ;
    schema:releaseDate "1943年7月1日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0421> ;
    schema:volumeNumber "1" ;
    schema:workPresented "白系" .

