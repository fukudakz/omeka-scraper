    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ふしぎな太鼓" ;
    schema:about "琵琶湖の源五郎ブナの伝説を人形映画化したもの。昔、薬売りの源五郎は天狗の子を助けて、お礼に不思議な太鼓をもらう。それをたたくと、鼻がのびたりちぢんだりするのだが、いたずらばかりに使ったため、天へ舞い上り、あげくの果ては琵琶湖へ落ちてフナになった。それ以来、琵琶湖のフナは源五郎ブナと呼ばれる様になった。" ;
    schema:audio "トーキー" ;
    schema:author "清水崑" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/15038>, <https://www.nihon-animation-eigashi.com/work-db/item/21281> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "人形製作：川本喜八郎", "撮影：岸次郎", "演出：持永只仁、田中喜次", "脚本：村治夫", "製作：稲村喜一" ;
    schema:dateCreated "1957年8月20日" ;
    schema:duration "19分" ;
    schema:identifier "NAE0565" ;
    schema:isBasedOn "岩波こどもの本『ふしぎなたいこ』 より" ;
    schema:materialExtent "520m" ;
    schema:name "ふしぎな太鼓" ;
