    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マー坊の大陸宣撫隊 前篇・サーカスの巻" ;
    schema:actors "解説：牧野周一" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/19585>, <https://www.nihon-animation-eigashi.com/work-db/item/19626> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "佐藤今二良", "演出：千葉洋路" ;
    schema:description "今日はマー坊の大サーカス。キリン君の曲芸、アヒルの網渡り、ヒョウの火縄くぐり、そ して、いよいよマー坊の空中大サーカス。この付近で一番お金持のお父さんと少女も見物。そこへ賊が襲撃、懐中物は盗まれ、着物ははがされ、観客全員まっ裸にされる。その上、見物の少女が誘拐される。" ;
    schema:duration "11分" ;
    schema:identifier "NAE0380" ;
    schema:materialExtent "303m" ;
    schema:name "マー坊の大陸宣撫隊 前篇・サーカスの巻" ;
    schema:pagination "225" ;
    schema:productionCompany "佐藤映画製作所" ;
    schema:releaseDate "1942年3月19日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0380> ;
    schema:volumeNumber "1" ;
    schema:workPresented "新宿 朝日ニュース劇場" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/767>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:03+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:48+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "マー坊の大陸宣撫隊 後篇・匪賊退治の巻" ;
    schema:actors "解説：牧野周一" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/19585>, <https://www.nihon-animation-eigashi.com/work-db/item/19626> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "佐藤今二良", "演出：千葉洋路" ;
    schema:description "誘拐された少女を救出にマー坊と一座の動物達は匪賊の山塞へ出発。居眠る番兵をやっつけて洞窟深く潜入。少女の身代金一万元と偽って匪賊に袋を渡すが、中から飛出したのはヘビ。 匪賊怒ってマー坊を落し穴へ落すが、ヘビをお菓子であやつり見事脱出。合図のピストルで動物達一斉に飛込み、匪賊は命からがら逃げ出す。残された金銀宝をカバ君が大砲につめ大空へ打ち上げると、空から降る宝に領民たちは大喜び。少女も父親の手に帰り、再び平和が甦る。" ;
    schema:duration "10分" ;
    schema:identifier "NAE0381" ;
    schema:materialExtent "281m" ;
    schema:name "マー坊の大陸宣撫隊 後篇・匪賊退治の巻" ;
    schema:pagination "225" ;
    schema:productionCompany "佐藤映画製作所" ;
    schema:releaseDate "1942年3月26日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0381> ;
    schema:volumeNumber "1" ;
    schema:workPresented "新宿 朝日ニュース劇場" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/768>
    rdf:type o:Item, schema:CreativeWork ;
