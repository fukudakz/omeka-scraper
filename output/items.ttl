<https://www.nihon-animation-eigashi.com/work-db/api/items/670>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "蛙の子" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "演出：岩田酉介" ;
    schema:description "蛙の家ではお母さん蛙の出産で大騒ぎ。 アヒルの産婆が来てオタマジャクシの卵が沢山生まれる。やがてオタマジャクシにかえるが、生みの親が誰なのか判らず親探しに出かける。金魚に出会うが、金魚は知らん顔。昼寝をしているナマズを見つけて色が黒いから父親だと、ヒゲを引っぱって起こす。ナマズは怒って一のみにし、一息で吐きとばす。魚釣りのミミズを見て食いつき、順にしっぽにぶら下がる。あわてて釣糸を引いた子供はオタマが行列でぶら下っているので「オタマか。蛙の子だ」と言って投げ出す。オタマ達は自分の親が蛙だと判り、水蓮の葉の上の親蛙を見つけ出して対面する。" ;
    schema:identifier "NAE0284" ;
    schema:name "蛙の子" ;
    schema:pagination "215" ;
    schema:productionCompany "深田商会映画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0284> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/671>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:10+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ピョンちゃんと小熊" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "演出：岩田酉介" ;
    schema:description "子兎のピョンちゃんと子熊の熊吉は仲よしの友達。ピョンちゃんの心配は父の眼が見えなくなったこと。学校から帰ると、毎日森のお宮にお詣りした。神様に願いは通じて三つの願いがかなう宝玉を授かった。喜んで家に帰る途中、熊吉が泣いている。熊吉の母が猪の作った落し穴に落ちたのだ。宝玉の力を借りてお母さんを助け出した。ピョンちゃんの父の眼も良くなった。熊吉母子はピョンちゃんの家へ引越し一緒に住んだ。" ;
    schema:identifier "NAE0285" ;
    schema:name "ピョンちゃんと小熊" ;
    schema:pagination "215" ;
    schema:productionCompany "深田商会映画部" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0285> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/672>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:02+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-04-01T05:27:47+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ターチャンの海底旅行" ;
    schema:about "【R6追加】\n2010年に映画保存協会の映画の里親第6回作品として9.5mmプリント（無声版）をもとに35mmに復元された。原作と編曲を担当した日立二郎は政岡の甥の政岡恒雄のペンネーム。" ;
    schema:alternateName "漫画 ターチャンの海底旅行" ;
    schema:audio "トーキー" ;
    schema:author "日立二郎" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/16737>, <https://www.nihon-animation-eigashi.com/work-db/item/20763>, <https://www.nihon-animation-eigashi.com/work-db/item/32507> ;
    schema:color "白黒" ;
    schema:composer "伴奏：政岡映画音楽部" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：熊川正雄、桑田良太郎、川島正義、竹内幸人", "撮影：原田誠一", "監督：政岡憲三", "編曲：日立二郎", "録音：J・O・トーキー・スタヂオ" ;
    schema:correction "別タイトル、製作、配給、解説を追加 [令和6年度メディア芸術アーカイブ推進支援事業によるデータベース制作]" ;
    schema:description "ターチャンとミーチャンの二人は豆潜水艇で海上を散歩。鯨が泳いでいるので、飛魚を捕えて鯨に投げる。鯨は餌を追って海中へ潜るので潜水艇も海底へ。驚いた大蟹は潜望鏡をハサミでチョン切る。ターチャン怒って魚形水雷を発射。大蟹は魚雷をはさんだままはるか向うへ。潜水艇を出て海中散歩していると沈没船がある。船の扉が開き大きな手がミーチャンをつかむ。沈没船に住む怪人がさらったのだ。ターチャンが助けようとすると扉は閉じる。ターチャンは龍宮にSOSを発した。龍王の命令一下、魚の進撃。ノコギリ鮫の突撃、オートジャイロ形で急行した蛸入道の爆弾、烏賊軍の煙幕展帳で、沈没船の怪人を攻撃。怪人と蛸入道の格闘の末、最後はターチャンの一撃で怪人は鯨の口の中へ。助かったミーチャンと抱き合うターチャン。二人は龍宮の使者亀の背に乗り海上へ。魚達が見送る。" ;
    schema:duration "8分" ;
    schema:identifier "NAE0286" ;
    schema:materialExtent "224m" ;
    schema:name "ターチャンの海底旅行" ;
    schema:pagination "215" ;
    schema:productionCompany "政岡映画研究所" ;
    schema:releaseDate "1935年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0286> ;
    schema:volumeNumber "1" .

