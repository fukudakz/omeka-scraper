<https://www.nihon-animation-eigashi.com/work-db/api/items/1218>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2026-03-30T14:31:42+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "蜜蜂マーヤの冒険" ;
    schema:about "CMを専門に製作していた日本テレビジョン株式会社の傘下に動画専門の製作会社として設立されたのがTCJプロダクションである。代表者・梁瀬次郎、常務・ジョン・S・田中らのメンバーで第一回作品にドイツのボンデルス原作の「蜜蜂マーヤ」をアンスコ・カラーで製作。同年五月東京で開催された第一回東南アジア映画祭の非劇映画部門で参加特別賞を受賞。" ;
    schema:color "アンスコ・カラー" ;
    schema:contentType "35mm" ;
    schema:contributor "動画：福田里三郎", "監督：芦田いわお" ;
    schema:dateCreated "1954年1月" ;
    schema:description "蜜蜂のマーヤは、いつもいばっているカブト虫がひっくり返って困っているのを助ける。 マーヤがクモの投縄にかかり危いところをカブト虫が恩返しに救ってくれる。やがてマーヤは敵の熊ん蜂軍に捕えられ、城に閉じこめられ、彼らの蜜蜂城総攻撃の話を聞く。苦心して城から脱出。 女王に注進し、反撃の準備。両軍の激突で大戦争となるが、マーヤのおかげで勝利。" ;
    schema:identifier "NAE0536" ;
    schema:name "蜜蜂マーヤの冒険" ;
    schema:pagination "245" ;
    schema:productionCompany "TCJプロダクション" ;
    schema:releaseDate "1954年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0536> ;
    schema:volumeNumber "1" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1219>
    rdf:type o:Item, schema:CreativeWork ;
