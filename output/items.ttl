    o:title "ホームラン" ;
    schema:alternateName "お猿のホームラン", "大ホームラン" ;
    schema:audio "トーキー" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/23520> ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "製作：村田安司" ;
    schema:description "お猿と白熊の野球戦、お猿軍はすでに8回表で8点の負け越し。食堂でラジオを聞いていたまかないのおばさん猿は、タクシーを乗り継いで野球場に駈けつけ、人参の栄養剤を届ける。猿軍、元気百倍、9回裏にホームランを連打、9点を入れ優勝する。" ;
    schema:duration "12分" ;
    schema:identifier "NAE0230" ;
    schema:materialExtent "316m" ;
    schema:name "ホームラン" ;
    schema:pagination "209" ;
    schema:releaseDate "1933年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0230> ;
    schema:volumeNumber "1" .

