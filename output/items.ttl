    o:modified "2026-04-01T05:27:51+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "やさしいライオン" ;
    schema:about "虫プロの中編動画の佳作。やなせたかしの原作は四十三年十月、山梨シルクセンター出版部刊の『アゴヒゲの好きな魔女』に収録された”やさしいライオン”。原作はコーラス・グループのボニージャックスの企画で、全編百十枚のスライド構成によるミュージカルになった。磯部俶作曲の“ブルブルの子守唄”は名曲。" ;
    schema:actors "[弟] 久里千春、[姉] 増山江威子" ;
    schema:audio "トーキー" ;
    schema:author "やなせたかし" ;
    schema:awards "1970年度教育映画祭特別賞", "四十四年度児童福祉文化賞奨励賞", "第二十四回毎日映画コンクール大藤賞", "第十八回キネマ旬報文化映画ベスト・テン八位" ;
    schema:collection <https://www.nihon-animation-eigashi.com/work-db/item/11334>, <https://www.nihon-animation-eigashi.com/work-db/item/12345>, <https://www.nihon-animation-eigashi.com/work-db/item/16284>, <https://www.nihon-animation-eigashi.com/work-db/item/16499> ;
    schema:color "イーストマン・カラー" ;
    schema:composer "作曲：磯部俶", "作詞：やなせたかし", "歌：ボニージャックス、久里千春 （ブルブルの子守唄）", "演奏：寺島尚彦とリズムシャンソネット+ストリングス", "編曲：寺島尚彦" ;
    schema:contentType "35mm" ;
    schema:contributor "トレス：島野昌子", "ブラシ：橋爪朋二", "効果：石田サウンドグループ", "動画：赤堀幹治、中村和子、上口照人、金山明博、松山マヤ、渡辺佳子、内海武雄、山守博昭", "彩色：阿部マリ子", "撮影：森昭彦", "演出：やなせたかし", "現像：東洋現像所", "編集：松浦典良", "背景：阿土延子、西村邦子、田辺めぐみ", "補佐：下崎闊", "製作担当：富岡厚司", "製作：手塚治虫", "録音：東京スタジオセンター", "音響：田代敦巳 （TAC）" ;
    schema:description "野外動物園に、孤児のライオンがいた。いつも泣いてブルブル震えてばかりでブルブルという名がついた。ムクムクと言う名の牝犬が母親代りで愛情一杯に育てあげた。成長したブルブルはついに都会の動物園へ移されることになった。一本道をブルブルを乗せたトラックを追い続ける母犬。ライオンのブルブルはサーカスの人気者になっていた。夜になると想い出すのは、ブルブルをおんぶして唄ってくれた母犬のやさしい子守唄。ある夜、遠くの方で子守唄が聞えた気がした。懐しい母の唄声に思わず檻を破り、町を走りぬけ、野越えて走り続けた。町はライオン脱走で大騒動。ついにライフルを持った警官隊がライオンを追う。白い雪の丘で、老いぼれて、やせ細り死にかけている母犬を見つけたブルブルは思わず母を抱きしめた。しかし非情な警官隊はライフルの一斎射撃。 純白の雪の上にブルブルの足跡がついていたが、 途中で足跡はぷっつり消えていた。その夜のこと、年寄り犬を乗せたライオンが月光りの夜空を飛んでいくのを見た人が何人もいた。母犬のブルブルに対する愛情が切々と表現されていた。" ;
    schema:duration "27分" ;
    schema:identifier "NAE0871" ;
    schema:isBasedOn "フレーベル館版『やさしいライオン』" ;
    schema:materialExtent "742m" ;
    schema:name "やさしいライオン" ;
    schema:pagination "301" ;
    schema:producer "企画協力：西北プロダクション" ;
    schema:productionCompany "虫プロダクション" ;
    schema:releaseDate "1970年3月21日" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0871> ;
    schema:volumeNumber "2" ;
    schema:workPresented "東宝系" .

<https://www.nihon-animation-eigashi.com/work-db/api/items/1554>
    rdf:type o:Item, schema:CreativeWork ;
