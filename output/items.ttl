<https://www.nihon-animation-eigashi.com/work-db/api/items/523>
    rdf:type o:Item, schema:CreativeWork ;
    o:created "2025-03-22T00:48:01+00:00"^^xsd:dateTime ;
    o:item_set <https://www.nihon-animation-eigashi.com/work-db/api/item_sets/4> ;
    o:modified "2025-03-30T15:16:07+00:00"^^xsd:dateTime ;
    o:owner <https://www.nihon-animation-eigashi.com/work-db/api/users/1> ;
    o:resource_class <https://www.nihon-animation-eigashi.com/work-db/api/resource_classes/534> ;
    o:resource_template <https://www.nihon-animation-eigashi.com/work-db/api/resource_templates/3> ;
    o:site <https://www.nihon-animation-eigashi.com/work-db/api/sites/1> ;
    o:title "ニつの太陽" ;
    schema:audio "サイレント" ;
    schema:color "白黒" ;
    schema:contentType "35mm" ;
    schema:contributor "作画：幹愴太", "原案：杉山健", "撮影：大石郁" ;
    schema:description "昔、夜のない国があった。その国には太陽が二つあり、夜昼なしに照りつけるので暑さによって人も鳥獣、草木も皆弱っていた。王様も困り果て「太陽の一つを征服した者には姫と領地の半分を与える」とおふれを出した。おふれは世界の果まで拡がり、沢山の勇士が集り、その中から三人が選ばれた。しかし試験で三人はそれぞれ失敗した。三人は力を合わせて太陽征伐に当たり、弓の名人の矢が太陽に命中。空中に飛散し、大きなカケラは月に、小さいのは星になった。初めてこの国に安息の夜がやって来た。三勇士は重い役目に任命された。" ;
    schema:duration "13分" ;
    schema:identifier "NAE0137" ;
    schema:materialExtent "234m" ;
    schema:name "ニつの太陽" ;
    schema:pagination "201" ;
    schema:productionCompany "岩岡商会" ;
    schema:releaseDate "1929年" ;
    schema:url <https://w3id.org/nihon-animation-eigashi/NAE0137> ;
    schema:volumeNumber "1" .

